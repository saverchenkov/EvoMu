# Rust build artifacts
/target/
/fuzz/target/
/fuzz/artifacts/
**/*.rs.bk

# Runtime logs and traces
/logs/
*.log
*.jsonl

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Local environment & IDE files
.env
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Independent review gate state (local; must not affect tree fingerprints)
/.evomu-reviews/*

# Generated runtime/SDE SQLite databases (raw .sqlite is local/gitignored; compressed golden archive .sqlite.xz is tracked)
/data/*.sqlite*
!/data/evomu_sde.sqlite.xz
/data/quasar_descriptors.*


# Local Quasar core-type wire golden vectors (client-derived; built by tools/quasar-import/core_golden.py)
/data/quasar_core_golden.json
