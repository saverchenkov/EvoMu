# Rust build artifacts
/target/
**/*.rs.bk

# Runtime logs and traces
/logs/
*.log
*.jsonl

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Local environment & IDE files
.env
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Independent review gate state (local; must not affect tree fingerprints)
/.evomu-reviews/*

# Generated runtime/SDE SQLite databases (rebuilt locally via tools/sde-import; never committed)
/data/*.sqlite*

