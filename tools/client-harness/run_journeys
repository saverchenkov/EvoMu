        outcomes["daily_goals_events"] = {
            "bridge_verified": bool(goal_prog and getattr(goal_prog, "goalID", None) == 2),
            "evidence": "Client 1 queried daily goal progress (goalID=2, verifiedFromLedger=%r)"
            % (getattr(goal_prog, "verifiedFromLedger", None),),
        }

        # Journey 4: mail_notifications & fleet between two concurrent clients
