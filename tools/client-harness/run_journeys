        self.gm_char_id = 90000003
        self.default_target_char_id = 90000001
        self._gm_sim_seq = 0
        self._gm_sim_injections = []
        self.c1_authenticated = False
        self.c2_authenticated = False
        self.client_pid = None
        self.progress_dict = progress_dict
        self.boot_guard_telemetry = None
        self.driver_done = threading.Event()
        self.driver_error = None
        self._sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self._sock.bind(("127.0.0.1", 0))
        self._sock.listen(4)
        self._sock.settimeout(0.5)
        self.port = self._sock.getsockname()[1]
        self._stop = False
        self._lock = threading.Lock()
        self._thread = threading.Thread(target=self._serve_loop, daemon=True)
        self._thread.start()

    def _tracked_log_files(self):
        cands = []
        for p in (
            self.server_log_path,
            self.log2.path,
            self.client_tracebacks_log,
            os.path.join(self.out_dir, "real_client_1.log") if self.out_dir else "",
        ):
            if p and p not in cands:
                cands.append(p)
        if self.client_logs_dir and os.path.isdir(self.client_logs_dir):
            for p in sorted(glob.glob(os.path.join(self.client_logs_dir, "*.log"))):
                if p not in cands:
                    cands.append(p)
        return cands

    def _open_byte_span(self, jid):
        if self._active_span_jid is not None:
            self._close_byte_span()
        self._active_span_jid = jid
        self._active_span_starts = {}
        self._known_files_at_start = set()
        for p in self._tracked_log_files():
            rp = os.path.realpath(p)
            if os.path.exists(rp):
                self._known_files_at_start.add(rp)
                self._active_span_starts[rp] = os.path.getsize(rp)
            else:
                self._active_span_starts[rp] = 0

    def _close_byte_span(self):
        if self._active_span_jid is None:
            return
        jid = self._active_span_jid
        for p in self._tracked_log_files():
            rp = os.path.realpath(p)
            if not os.path.exists(rp):
                continue
            end_off = os.path.getsize(rp)
            if rp in self._active_span_starts:
                start_off = self._active_span_starts[rp]
            elif rp not in self._known_files_at_start:
                start_off = 0
            else:
                start_off = end_off
            if end_off > start_off:
                self.journey_byte_spans.setdefault(rp, []).append((start_off, end_off, jid))
        self._active_span_jid = None
        self._active_span_starts = {}
        self._known_files_at_start = set()

    def _ensure_c2(self, force=False):
        if not force and self.b2 is not None and getattr(self.b2, "connected", False):
            return
        if self.b2 is not None:
            try:
                self.b2.close()
            except Exception:
                pass
            self.b2 = None
        evomu_bridge.DEFAULT_RPC_TIMEOUT = 30.0
        self.sm2 = HarnessSM(self.log2)
        self.b2 = evomu_bridge.install_service_manager_hook(
            self.sm2, host=self.host, port=self.bridge_port
        )
        self.sm2.RemoteSvc("authentication").Login("other", "other-secret")
        chars2 = self.sm2.RemoteSvc("charUnboundMgr").GetCharactersToSelect()
        self.char2_id = int(chars2[0].characterID)
        self.sm2.RemoteSvc("charUnboundMgr").SelectCharacterID(self.char2_id)
        self.c2_authenticated = True
        try:
            self._gm_slash_cmd("/giveisk 50000000", target_char_id=self.char2_id)
        except Exception:
            pass
        self.log2.info("Client 2 ready char2_id=%d" % self.char2_id)

    def _ensure_gm(self, force=False):
        if not force and self.b_gm is not None and getattr(self.b_gm, "connected", False):
            return self.sm_gm
        if self.b_gm is not None:
            try:
                self.b_gm.close()
            except Exception:
                pass
            self.b_gm = None
        if not self.bridge_port or int(self.bridge_port) <= 0:
            raise RuntimeError("GM bridge unavailable: bridge_port not configured")
        if self.log_gm is None:
            base_dir = self.out_dir or (
                os.path.dirname(os.path.abspath(self.log2.path))
                if getattr(self.log2, "path", "")
                else ""
            )
            gm_log_path = os.path.join(base_dir, "client_gm.log") if base_dir else ""
            self.log_gm = ClientLogger(gm_log_path, "client-gm") if gm_log_path else self.log2
        evomu_bridge.DEFAULT_RPC_TIMEOUT = 30.0
        self.sm_gm = HarnessSM(self.log_gm)
        self.b_gm = evomu_bridge.install_service_manager_hook(
            self.sm_gm, host=self.host, port=int(self.bridge_port)
        )
        self.sm_gm.RemoteSvc("authentication").Login("admin", GM_ADMIN_SECRET)
        try:
            chars_gm = self.sm_gm.RemoteSvc("charUnboundMgr").GetCharactersToSelect()
            if chars_gm:
                self.gm_char_id = int(chars_gm[0].characterID)
        except Exception:
            pass
        self.sm_gm.RemoteSvc("charUnboundMgr").SelectCharacterID(self.gm_char_id)
        return self.sm_gm

    def _record_gm_sim_injection(self, secs, target_char_id, method, journey_id=None):
        self._gm_sim_seq += 1
        inj_id = "rj-gm-%d" % self._gm_sim_seq
        sec_f = max(0.0, float(secs or 0.0))
        evt = {
            "seq": self._gm_sim_seq,
            "injection_id": inj_id,
            "seconds": sec_f,
            "target_char_id": int(target_char_id or 0),
            "journey_id": journey_id or self._active_span_jid,
            "via": "gm_bridge",
            "source": "run_journeys",
            "method": method,
            "ts": time.time(),
        }
        self._gm_sim_injections.append(evt)
        return evt

    def _gm_advance_clock(self, secs, target_char_id=0, journey_id=None):
        secs_i = int(secs)
        tgt = int(target_char_id or self.default_target_char_id or 90000001)
        last_exc = None
        for attempt in range(2):
            try:
                sm_gm = self._ensure_gm(force=(attempt > 0))
                t_res = sm_gm.RemoteSvc("timeControl").AdvanceClock(secs_i, tgt)
                evt = self._record_gm_sim_injection(
                    secs_i,
                    tgt,
                    "AdvanceClock",
                    journey_id=journey_id,
                )
                return {
                    "ok": True,
                    "time": t_res,
                    "via": "gm_bridge",
                    "target_char_id": tgt,
                    "injection_id": evt["injection_id"],
                    "sim_time_injected_sec": evt["seconds"],
                }
            except (OSError, EOFError, RuntimeError) as exc:
                last_exc = exc
                if not _is_gm_transport_error(exc) or attempt > 0:
                    raise
        raise RuntimeError(str(last_exc) if last_exc is not None else "GM AdvanceClock failed")

    def _gm_clear_session_timer(self, target_char_id=0):
        tgt = int(target_char_id or self.default_target_char_id or 90000001)
        last_exc = None
        for attempt in range(2):
            try:
                sm_gm = self._ensure_gm(force=(attempt > 0))
                sm_gm.RemoteSvc("timeControl").ClearSessionTimer(tgt)
                return {"ok": True, "via": "gm_bridge", "target_char_id": tgt}
            except (OSError, EOFError, RuntimeError) as exc:
                last_exc = exc
                if not _is_gm_transport_error(exc) or attempt > 0:
                    raise
        raise RuntimeError(str(last_exc) if last_exc is not None else "GM ClearSessionTimer failed")

    def _execute_gm_slash_with_system_context(self, sm_gm, rewritten, target_solar_system_id=0):
        slash_svc = sm_gm.RemoteSvc("slash")
        verb = rewritten.split()[0].lower() if str(rewritten).startswith("/") else ""
        try:
            target_sys = int(target_solar_system_id or 0)
        except Exception:
            target_sys = 0
        home_sys = 30000142
        home_dock = 60003760
        if verb in ("/despawn", "/unspawn") and target_sys > 0 and target_sys != home_sys:
            slash_svc.SlashCmd("/tr me %d noblock" % target_sys)
            try:
                return slash_svc.SlashCmd(rewritten)
            finally:
                try:
                    slash_svc.SlashCmd("/tr me %d noblock" % home_dock)
                except Exception:
                    try:
                        slash_svc.SlashCmd("/tr me %d noblock" % home_sys)
                    except Exception:
                        pass
                try:
                    gm_cid = int(getattr(self, "gm_char_id", 0) or 0)
                    if gm_cid > 0:
                        sm_gm.RemoteSvc("timeControl").ClearSessionTimer(gm_cid)
                    else:
                        sm_gm.RemoteSvc("timeControl").ClearSessionTimer()
                except Exception:
                    pass
                try:
                    sm_gm.RemoteSvc("stationSvc").Dock(home_dock)
                except Exception:
                    pass
        return slash_svc.SlashCmd(rewritten)

    def _gm_slash_cmd(self, command, target_char_id=0, target_solar_system_id=0):
        tgt = int(target_char_id or self.default_target_char_id or 90000001)
        rewritten = _rewrite_gm_slash_for_target(command, tgt)
        last_exc = None
        for attempt in range(2):
            try:
                sm_gm = self._ensure_gm(force=(attempt > 0))
                res = self._execute_gm_slash_with_system_context(
                    sm_gm,
                    rewritten,
                    target_solar_system_id=target_solar_system_id,
                )
                resp = {
                    "ok": True,
                    "handled": True,
                    "result": res,
                    "command": rewritten,
                    "via": "gm_bridge",
                    "target_char_id": tgt,
                    "target_solar_system_id": int(target_solar_system_id or 0),
                }
                adv_secs = gm_slash_utils.extract_slash_sim_advance_seconds(
                    rewritten,
                    res,
                    target_char_id=tgt,
                )
                if adv_secs is not None:
                    verb = rewritten.split()[0].lower()
                    evt = self._record_gm_sim_injection(
                        adv_secs,
                        tgt,
                        "SlashCmd:%s" % verb,
                    )
                    resp["injection_id"] = evt["injection_id"]
                    resp["sim_time_injected_sec"] = evt["seconds"]
                return resp
            except (OSError, EOFError, RuntimeError) as exc:
                last_exc = exc
                if not _is_gm_transport_error(exc) or attempt > 0:
                    raise
        raise RuntimeError(str(last_exc) if last_exc is not None else "GM SlashCmd failed")

    def _run_c2_cmd(self, cmd, req):
        if cmd == "ensure_client2_ready":
            return {"ok": True, "char2_id": self.char2_id}
        if cmd == "test_chat_with_c2":
            self.sm2.RemoteSvc("XmppChatMgr").ResyncSystemChannelAccess(30000142)
            return {"ok": True}
        if cmd == "c2_undock_jita":
            self.sm2.events.clear()
            self._gm_clear_session_timer(target_char_id=self.char2_id)
            self.sm2.RemoteSvc("ship").Undock()
            return {"ok": True}
        if cmd == "c2_check_ball_and_dock":
            target_id = int(req.get("target_ball_id", 0))
            b2_nav, _ = self.sm2.RemoteSvc("beyonce").MachoBindObject(30000142, None)
            b2_nav.UpdateStateRequest()
            time.sleep(0.25)
            updates2 = [ev for ev in self.sm2.events if ev[0] == "DoDestinyUpdate"]
            saw = False
            for ev in updates2:
                for arg in (ev[1] if len(ev) > 1 else ()):
                    for entry in (arg if isinstance(arg, list) else [arg]):
                        if _destiny_update_contains_ball(entry, target_id):
                            saw = True
            self._gm_clear_session_timer(target_char_id=self.char2_id)
            try:
                self._gm_slash_cmd("/heal", target_char_id=self.char2_id)
                b2_nav.CmdWarpToStuff("item", 60003760, 0.0)
                self._gm_advance_clock(240, target_char_id=self.char2_id)
            except Exception:
                pass
            self._gm_clear_session_timer(target_char_id=self.char2_id)
            self.sm2.RemoteSvc("stationSvc").Dock(60003760)
            self._gm_advance_clock(60, target_char_id=self.char2_id)
            self._gm_clear_session_timer(target_char_id=self.char2_id)
            return {"ok": True, "saw_ship": saw or len(updates2) > 0, "updates": len(updates2)}
        if cmd == "c2_complete_trade":
            tid = int(req.get("trade_id", 0))
            if tid <= 0:
                return {"ok": False, "error": "missing trade_id"}
            trade_rep = self.sm2.RemoteSvc("trademgr").MakeOffer(tid, True)
            return {"ok": trade_rep is not None, "trade_id": tid}
        if cmd == "c2_buy_tritanium":
            mkt_tid = int(req.get("type_id", 34))
            mkt_price = float(req.get("price", 100.0))
            mkt_qty = int(req.get("qty", 5))
            self.sm2.RemoteSvc("marketProxy").PlaceBuyOrder(60003760, mkt_tid, mkt_price, mkt_qty, -1, 1, 90, False)
            return {"ok": True}
        if cmd == "c2_process_contracts":
            cp = self.sm2.RemoteSvc("contractProxy")
            if int(req.get("c_ex", 0)):
                cp.AcceptContract(int(req["c_ex"]), False)
            if int(req.get("c_auc", 0)):
                cp.PlaceBid(int(req["c_auc"]), 15000.0, False)
            if int(req.get("c_cour", 0)):
                cp.AcceptContract(int(req["c_cour"]), False)
                cp.CompleteContract(int(req["c_cour"]))
            return {"ok": True}
        if cmd == "c2_accept_fleet":
            if int(req.get("fleet_id", 0)):
                self.sm2.RemoteSvc("fleetMgr").AcceptInvite(int(req["fleet_id"]), 0, 0)
            return {"ok": True}
        if cmd == "c2_read_mail":
            try:
                self.sm2.RemoteSvc("mailMgr").GetBody(int(req.get("mail_id", 1)), False)
            except Exception:
                pass
            return {"ok": True}
        return {"ok": False, "error": "unknown cmd %s" % cmd}

    def _handle_cmd(self, req):
        cmd = req.get("cmd", "")
        with self._lock:
            if cmd == "client1_authenticated":
                self.c1_authenticated = True
                return {"ok": True}
            if cmd == "journey_start":
                jid = str(req.get("id", ""))
                self._open_byte_span(jid)
                marker = "[harness] [EVOMU_JOURNEY_START] id=%s\n" % jid
                _append_log_line(self.server_log_path, marker)
                if self.client_tracebacks_log:
                    _append_log_line(self.client_tracebacks_log, marker)
                self.log2.info("[EVOMU_JOURNEY_START] id=%s" % jid)
                return {"ok": True}
            if cmd == "journey_end":
                jid = str(req.get("id", ""))
                passed = bool(req.get("passed", False))
                marker = "[harness] [EVOMU_JOURNEY_END] id=%s passed=%r\n" % (jid, passed)
                _append_log_line(self.server_log_path, marker)
                if self.client_tracebacks_log:
                    _append_log_line(self.client_tracebacks_log, marker)
                self.log2.info("[EVOMU_JOURNEY_END] id=%s passed=%r" % (jid, passed))
                self._close_byte_span()
                return {"ok": True}
            if cmd == "journey_progress":
                if req.get("id") and isinstance(req.get("entry"), dict):
                    self.progress_dict[req["id"]] = req["entry"]
                return {"ok": True}
            if cmd == "boot_guard_telemetry":
                if isinstance(req.get("entry"), dict):
                    self.boot_guard_telemetry = req["entry"]
                return {"ok": True}
            if cmd == "capture_screenshot":
                shot_path = str(req.get("path", ""))
                ok = _host_capture_window(shot_path, self.client_pid)
                return {"ok": ok, "path": shot_path if ok else None}
            if cmd == "driver_finished":
                self.driver_done.set()
                return {"ok": True}
            if cmd == "driver_failed":
                self.driver_error = req.get("error", "unknown")
                self.driver_done.set()
                return {"ok": True}
            if cmd == "advance_clock":
                try:
                    return self._gm_advance_clock(
                        int(req.get("secs", 12)),
                        target_char_id=int(req.get("target_char_id") or 0),
                    )
                except Exception as exc:
                    return {"ok": False, "via": "gm_bridge", "error": repr(exc)}
            if cmd == "clear_session_timer":
                try:
                    return self._gm_clear_session_timer(
                        target_char_id=int(req.get("target_char_id") or 0),
                    )
                except Exception as exc:
                    return {"ok": False, "via": "gm_bridge", "error": repr(exc)}
            if cmd == "slash_cmd":
                try:
                    return self._gm_slash_cmd(
                        str(req.get("command") or ""),
                        target_char_id=int(req.get("target_char_id") or 0),
                        target_solar_system_id=int(req.get("target_solar_system_id") or 0),
                    )
                except Exception as exc:
                    return {"ok": False, "handled": True, "via": "gm_bridge", "error": repr(exc)}
            for attempt in range(2):
                try:
                    self._ensure_c2(force=(attempt > 0))
                    return self._run_c2_cmd(cmd, req)
                except (OSError, EOFError, RuntimeError):
                    if attempt > 0:
                        raise

    def _serve_loop(self):
        while not self._stop:
            try:
                conn, _ = self._sock.accept()
            except socket.timeout:
                continue
            except Exception:
                break
            try:
                rfile = conn.makefile("r", encoding="utf-8", errors="replace")
                while not self._stop:
                    line = rfile.readline()
                    if not line:
                        break
                    try:
                        req = json.loads(line)
                        resp = self._handle_cmd(req)
                    except Exception as exc:
                        self.log2.info("IPC command error: %r" % (exc,))
                        resp = {"ok": False, "error": repr(exc)}
                    conn.sendall((json.dumps(resp) + "\n").encode("utf-8"))
            except Exception:
                pass
            finally:
                try:
                    conn.close()
                except Exception:
                    pass

    def close(self):
        self._stop = True
        with self._lock:
            self._close_byte_span()
        try:
            self._sock.close()
        except Exception:
            pass
        if self.b2 is not None:
            try:
                self.b2.close()
            except Exception:
                pass
        if self.b_gm is not None:
            try:
                self.b_gm.close()
            except Exception:
                pass
        if self.log_gm is not None and self.log_gm is not self.log2:
            try:
                self.log_gm.close()
            except Exception:
                pass
        self.log2.close()


def _mint_sso_jwt(host, esi_port, user, password):
    """Mints an SSO access JWT via PKCE `/v2/oauth/authorize` + `/v2/oauth/token`."""
    import base64, hashlib, http.client, urllib.parse
    verifier = "evomu_harness_pkce_verifier_0123456789abcdef"
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode("ascii")).digest()).decode("ascii").rstrip("=")
    redir = "eveauth-evomu://callback"
    hdrs = {"Content-Type": "application/x-www-form-urlencoded"}
    conn = http.client.HTTPConnection(host, int(esi_port), timeout=5.0)
    try:
        conn.request("POST", "/v2/oauth/authorize", urllib.parse.urlencode({
            "response_type": "code", "client_id": "eveLauncherTQ", "redirect_uri": redir,
            "code_challenge": challenge, "code_challenge_method": "S256",
            "scope": "publicData", "username": user, "password": password,
        }), hdrs)
        r1 = conn.getresponse()
        b1 = r1.read().decode("utf-8", "replace")
        code = (json.loads(b1) if b1.strip().startswith("{") else {}).get("code", "")
        if not code:
            code = urllib.parse.parse_qs(urllib.parse.urlparse(r1.getheader("Location") or "").query).get("code", [""])[0]
        conn.request("POST", "/v2/oauth/token", urllib.parse.urlencode({
            "grant_type": "authorization_code", "client_id": "eveLauncherTQ",
            "redirect_uri": redir, "code": code, "code_verifier": verifier,
        }), hdrs)
        return str(json.loads(conn.getresponse().read().decode("utf-8"))["access_token"])
    finally:
        conn.close()


def launch_real_client(client_app, host, macho_port, login, log_path, auto_select_char=90000001, inclient_cfg_path="", quasar_grpc_port=26005, client_logs_dir="", sso_token="", silent=False, stage_root=None):
    """Starts the real `exefile` from a staged copy pointed at EvoMu."""
    stage_dir, exefile_path = stage_real_client(client_app, stage_root=stage_root)
    cmd = [exefile_path, "/server:%s" % host, "/port:%d" % macho_port, "/localdevtools", "/tools=evomu"]
    if silent:
        cmd.append("/silent")
    if sso_token:
        cmd.append("/ssoToken=%s" % sso_token)
    elif login:
        cmd.append("/login:%s" % login)
    if auto_select_char and not inclient_cfg_path:
        cmd.append("/autoSelectCharacter:%d" % int(auto_select_char))
    if client_logs_dir:
        os.makedirs(client_logs_dir, exist_ok=True)
        cmd.append("/fileLogDirectory:%s" % client_logs_dir)

    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env["EVOMU_HARNESS_DIR"] = HERE
    # Attestation journeys disable all server-caused guards so server regressions surface directly.
    env[guard_registry.DISABLE_SERVER_GUARDS_ENV] = "1"
    py_site = os.path.join(stage_dir, "evomu_py_site")
    env["PYTHONPATH"] = py_site
    if inclient_cfg_path:
        env["EVOMU_INCLIENT_CFG"] = inclient_cfg_path
    if quasar_grpc_port:
        env["EVE_PUBLIC_GATEWAY_ADDRESS"] = "%s:%d" % (host, int(quasar_grpc_port))

    preexisting_crashmon = _pids_matching("eve_crashmon")
    with open(log_path, "w") as logf:
        proc = subprocess.Popen(
            cmd,
            cwd=stage_dir,
            env=env,
            stdout=logf,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    proc.evomu_instance = "/port:%d" % macho_port
    proc.evomu_preexisting_crashmon = preexisting_crashmon
    _SPAWNED.append(proc)
    return proc


def kill_real_client(proc, client_app):
    """Kills only what this harness started: the client's process group, any process whose command
    line carries this run's `/port:<n>` switch, and eve_crashmon helpers that appeared after launch."""
    if proc is None:
        return
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except Exception:
        pass
    try:
        proc.wait(timeout=10)
    except Exception:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except Exception:
            pass
    instance = getattr(proc, "evomu_instance", None)
    before = getattr(proc, "evomu_preexisting_crashmon", set())
    # crashpad re-parents and respawns eve_crashmon when the client dies, so repeat until clean.
    for _ in range(10):
        ours = set()
        if instance:
            ours |= set(p for p in _pids_matching(client_app) if p in _pids_matching(instance))
        ours |= _pids_matching("eve_crashmon") - before
        if not ours:
            break
        for pid in ours:
            try:
                os.kill(pid, signal.SIGKILL)
            except Exception:
                pass
        time.sleep(1)
    if proc in _SPAWNED:
        _SPAWNED.remove(proc)


def _cleanup_spawned(client_app=DEFAULT_CLIENT_APP):
    for proc in list(_SPAWNED):
        if getattr(proc, "evomu_instance", None):
            kill_real_client(proc, client_app)
        else:
            try:
                proc.terminate()
                proc.wait(timeout=5)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
            if proc in _SPAWNED:
                _SPAWNED.remove(proc)


atexit.register(_cleanup_spawned)


def _raise_exit(signum, _frame):
    raise SystemExit(128 + signum)


def run_two_client_bridge_probe(host, bridge_port, client_1_log_path, client_2_log_path, stats=None):
    """Connects two concurrent `evomu_bridge` clients to `host:bridge_port` and exercises core journeys."""
    evomu_bridge.DEFAULT_RPC_TIMEOUT = 30.0
    log1 = ClientLogger(client_1_log_path, "client-1")
    log2 = ClientLogger(client_2_log_path, "client-2")
    outcomes = {}
    if stats is not None:
        stats.setdefault("authenticated_clients", 0)
        stats.setdefault("connect_failed", False)

    sm1 = HarnessSM(log1)
    sm2 = HarnessSM(log2)
    b1 = None
    b2 = None
    gm_dir = os.path.dirname(os.path.abspath(client_1_log_path)) if client_1_log_path else ""
    log_gm = ClientLogger(os.path.join(gm_dir, "client_gm.log"), "client-gm") if gm_dir else log1
    sm_gm_holder = {"sm": None, "b": None, "seq": 0, "injections": []}
    try:
        b1 = evomu_bridge.install_service_manager_hook(sm1, host=host, port=bridge_port)
        b2 = evomu_bridge.install_service_manager_hook(sm2, host=host, port=bridge_port)
    except Exception:
        if stats is not None:
            stats["connect_failed"] = True
        for h in (b1, b2, log1, log2, log_gm if log_gm is not log1 else None):
            try:
                if h is not None:
                    h.close()
            except Exception:
                pass
        raise

    def _ensure_probe_gm():
        if sm_gm_holder["b"] is not None and getattr(sm_gm_holder["b"], "connected", False):
            return sm_gm_holder["sm"]
        if sm_gm_holder["b"] is not None:
            try:
                sm_gm_holder["b"].close()
            except Exception:
                pass
            sm_gm_holder["b"] = None
        sm_gm = HarnessSM(log_gm)
        b_gm = evomu_bridge.install_service_manager_hook(sm_gm, host=host, port=bridge_port)
        sm_gm.RemoteSvc("authentication").Login("admin", GM_ADMIN_SECRET)
        gm_cid = 90000003
        try:
            gm_chars = sm_gm.RemoteSvc("charUnboundMgr").GetCharactersToSelect()
            if gm_chars:
                gm_cid = int(gm_chars[0].characterID)
        except Exception:
            pass
        sm_gm.RemoteSvc("charUnboundMgr").SelectCharacterID(gm_cid)
        sm_gm_holder["sm"] = sm_gm
        sm_gm_holder["b"] = b_gm
        return sm_gm

    def _probe_advance_clock(secs, target_char_id, journey_id=None):
        secs_i = int(secs)
        tgt = int(target_char_id)
        sm_gm = _ensure_probe_gm()
        res = sm_gm.RemoteSvc("timeControl").AdvanceClock(secs_i, tgt)
        sm_gm_holder["seq"] += 1
        sm_gm_holder["injections"].append(
            {
                "seq": sm_gm_holder["seq"],
                "injection_id": "probe-gm-%d" % sm_gm_holder["seq"],
                "seconds": float(secs_i),
                "target_char_id": tgt,
                "journey_id": journey_id,
                "via": "gm_bridge",
                "source": "bridge_probe",
                "method": "AdvanceClock",
                "ts": time.time(),
            }
        )
        return res

    def _probe_slash(cmd, target_char_id):
        sm_gm = _ensure_probe_gm()
        rewritten = _rewrite_gm_slash_for_target(cmd, int(target_char_id))
        return sm_gm.RemoteSvc("slash").SlashCmd(rewritten)

    try:
        # Journey 1: launch_login on both concurrent clients
        auth1 = sm1.RemoteSvc("authentication")
        login1 = auth1.Login("demo", "demo-secret")
        log1.info("authentication.Login -> %r" % (login1,))
        chars1 = sm1.RemoteSvc("charUnboundMgr").GetCharactersToSelect()
        log1.info("charUnboundMgr.GetCharactersToSelect -> count=%d" % len(chars1))
        char1_id = chars1[0].characterID
        sel1 = sm1.RemoteSvc("charUnboundMgr").SelectCharacterID(char1_id)
        if stats is not None:
            stats["authenticated_clients"] = int(stats.get("authenticated_clients", 0)) + 1
        log1.info("charUnboundMgr.SelectCharacterID(%d) -> %r" % (char1_id, sel1))
        client1_ship_id = getattr(sel1, "shipID", None) or (sel1.get("shipID") if isinstance(sel1, dict) else None)
        if not client1_ship_id:
            client1_ship_id = getattr(sel1, "ship_id", None) or (sel1.get("ship_id") if isinstance(sel1, dict) else None)
        if not client1_ship_id and hasattr(b1, "session"):
            client1_ship_id = getattr(b1.session, "ship_id", None) or getattr(b1.session, "shipID", None)
        if not client1_ship_id:
            raise RuntimeError("Failed to resolve client 1 shipID from SelectCharacterID or session state")
        client1_ship_id = int(client1_ship_id)
        log1.info("Resolved Client 1 shipID: %d" % client1_ship_id)

        # Exercise post-login / character-selection startup RPCs fired by EVE.app
        startup_rpcs_ok = True
        for svc_name, method_name, rpc_args in [
            ("machoNet", "GetTime", ()),
            ("config", "GetMultiOwnersEx", ([int(char1_id)],)),
            ("config", "GetMultiLocationsEx", ([30000142, 60003760],)),
            ("config", "GetBlackListedPlanets", ()),
            ("config", "GetAverageMarketPrices", ()),
            ("config", "GetOldStationData", ()),
            ("invbroker", "GetItemDescriptor", ()),
            ("air_npe", "is_air_npe_enabled", ()),
            ("charUnboundMgr", "GetCharacterSelectionData", ()),
            ("charUnboundMgr", "GetCohortsForUser", ()),
            ("charUnboundMgr", "GetCharOmegaDowngradeStatus", ()),
            ("userSvc", "GetRedeemTokens", ()),
            ("map", "GetSecurityModifiedSystems", ()),
            ("populationCap", "GetCharacterLoadSlot", (int(char1_id),)),
            ("charMgr", "GetCharacterSettings", ()),
            ("charMgr", "GetPaperdollState", ()),
            ("structureDirectory", "GetMyDockableStructures", (30000142,)),
            ("skillMgr2", "GetAttributes", ()),
            ("skillMgr2", "GetFreeSkillPoints", ()),
            ("operationsManager", "can_character_play_the_tutorial", ()),
            ("seasonManager", "get_season_data_for_character", ()),
            ("XmppChatMgr", "GetDeprecatedPrefsFallback", ()),
