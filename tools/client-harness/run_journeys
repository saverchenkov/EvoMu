        for req_col in ("price", "volRemaining", "typeID", "orderID", "volEntered", "minVolume", "bid", "stationID", "regionID", "range", "issueDate", "duration", "solarSystemID", "constellationID", "jumps"):
            assert hasattr(ask_rows[0], req_col) or (isinstance(ask_rows[0], dict) and req_col in ask_rows[0]), "GetOrders row missing %s" % req_col
        placed_buy = mkt.PlaceBuyOrder(60003760, 34, 0.50, 50, -1, 1, 90, False)
