        # Journey 25: Starter PLEX grant (Client 2) + Free Fast-Checkout PLEX packs, VGS storeManager purchase & shipCosmeticsMgr SKIN activation
        fc2_buy = sm2.RemoteSvc("FastCheckoutService").BuyOffer(1, 1)
        assert fc2_buy.get("status") == "COMPLETED"
        assert int(fc2_buy["newPlexBalance"]) >= 50100

        fc_enabled = sm1.RemoteSvc("FastCheckoutService").IsFastCheckoutEnabledForUser()
