                raise
        flush = sm1.RemoteSvc("planetMgr").Flush(40009077)
        log1.info("planetMgr.Flush(40009077) -> %r" % (flush,))
        outcomes["planetary"] = {
            "bridge_verified": bool(pinfo and colony and flush),
            "evidence": "planetMgr.UserUpdateNetwork & Flush on Jita planet 40009077 produced typeID=%r qty=%r"
            % (getattr(flush, "producedTypeID", None), getattr(flush, "producedQuantity", None)),
        }

        # Journey 7: undock_navigate & multiplayer_presence
        beyonce1, _ = sm1.RemoteSvc("beyonce").MachoBindObject(30000142, None)
        formations = beyonce1.GetFormations()
        beyonce1.UpdateStateRequest()
        beyonce2.UpdateStateRequest()

        # Journey: pve_combat (targeting system queries on grid)
        targets1 = sm1.RemoteSvc("dogmaIM").GetTargets()
        targeters1 = sm1.RemoteSvc("dogmaIM").GetTargeters()
        log1.info("dogmaIM: targets=%r targeters=%r" % (targets1, targeters1))
        outcomes["pve_combat"] = {
            "bridge_verified": targets1 is not None and targeters1 is not None,
            "evidence": "Client 1 queried space targeting state (GetTargets=%r, GetTargeters=%r)"
            % (targets1, targeters1),
        }

        # Align to celestial (Jita I, celestialID 40009077)
        align1 = beyonce1.CmdAlignTo(dstID=40009077)
        log1.info("beyonce1.CmdAlignTo(dstID=40009077) -> %r" % (align1,))

        # Sub-warp acceleration to max velocity (fraction 1.0)
        speed1 = beyonce1.CmdSetSpeedFraction(1.0)
        log1.info("beyonce1.CmdSetSpeedFraction(1.0) -> %r" % (speed1,))
        time.sleep(0.3)
        snap1_moving = beyonce1.UpdateStateRequest()
        log1.info("Ship state during acceleration -> %r" % (snap1_moving,))

        # Stop
        stop1 = beyonce1.CmdStop()
        log1.info("beyonce1.CmdStop() -> %r" % (stop1,))
        time.sleep(0.2)
        snap1_stopped = beyonce1.UpdateStateRequest()
        log1.info("Ship state after stop -> %r" % (snap1_stopped,))

        # Check ballpark entity synchronization from second client
        beyonce2.UpdateStateRequest()
        time.sleep(0.2)
        destiny_updates2 = [ev for ev in sm2.events if ev[0] == "DoDestinyUpdate"]
        observed_client1_events = []
        for ev in destiny_updates2:
            args = ev[1] if len(ev) > 1 else ()
            for arg in args:
                entries = arg if isinstance(arg, list) else [arg]
                for entry in entries:
                    if _destiny_update_contains_ball(entry, client1_ship_id):
                        observed_client1_events.append(entry)

        log2.info(
            "Client 2 undocked into 30000142 (%r) and received %d DoDestinyUpdate events (%d containing Client 1 ship %d)"
            % (undock2, len(destiny_updates2), len(observed_client1_events), client1_ship_id)
        )

        # Client 2 redocks at Jita 4-4 station (deterministic mock clock advance past 10s session timer)
        beyonce2.CmdStop()
        _probe_advance_clock(12, int(char2_id), journey_id="multiplayer_presence")
        dock2 = sm2.RemoteSvc("stationSvc").Dock(60003760)
        log2.info("Client 2 redocked at 60003760 -> %r" % (dock2,))

        # Verify destiny updates received on Client 1
        destiny_updates1 = [ev for ev in sm1.events if ev[0] == "DoDestinyUpdate"]
        log1.info("Client 1 recorded %d DoDestinyUpdate events" % len(destiny_updates1))

        outcomes["multiplayer_presence"] = {
            "bridge_verified": len(observed_client1_events) > 0,
            "evidence": "Client 2 undocked into Jita (30000142) and verified Client 1 ship %d presence across %d destiny payload(s) (%d total DoDestinyUpdate packets)"
            % (client1_ship_id, len(observed_client1_events), len(destiny_updates2)),
        }

        # Journey 8: wormholes_filaments (warp >1,000 km off stations/gates to Jita IV 40009082, filament activation, session change)
        warp1 = beyonce1.CmdWarpToStuff("item", 40009082)
        log1.info("beyonce1.CmdWarpToStuff(40009082) -> %r" % (warp1,))
        time.sleep(0.2)
        # Allow full Rifter align+warp (~20s) plus 10s post-warp invulnerability expiry before filament activation.
        _probe_advance_clock(35, int(char1_id), journey_id="wormholes_filaments")
        stop_warp = beyonce1.CmdStop()
        log1.info("beyonce1.CmdStop() after warp command -> %r" % (stop_warp,))

        # Activate Needlejack filament (53977 Noise-5 'Needlejack' Filament) from ship Cargo
        try:
            _probe_slash("/createitem 53977 1", int(char1_id))
        except Exception:
            pass
        fil_res = sm1.RemoteSvc("randomJumpMgr").ActivateRandomJumpFilament()
        log1.info("randomJumpMgr.ActivateRandomJumpFilament -> %r" % (fil_res,))
        time.sleep(0.2)

        # Check session change on Client 1 to destination nullsec system
        abyssal_sys = int(getattr(fil_res, "solarSystemID", 0) or 0) if fil_res else 0
        abyssal_session_changed = any(
            ev[0] == "OnSessionChanged" and str(abyssal_sys) in str(ev[1])
            for ev in sm1.events
        )
        abyssal_beyonce, _ = sm1.RemoteSvc("beyonce").MachoBindObject(abyssal_sys, None)
        abyssal_beyonce.UpdateStateRequest()
        log1.info("Bound to destination beyonce in %d and called UpdateStateRequest" % int(abyssal_sys))

        # Verify in-space disconnect + reconnect (`SelectCharacterID` -> `beyonce.MachoBindObject` WITHOUT
        # `UpdateStateRequest`, matching `Michelle.AddBallpark` -> `Park.InitializeRemoteBallpark`)
        # delivers `SetState` at index 0 (`state[0][1][0] == "SetState"`) via `DoDestinyUpdate` even when
        # a 1Hz tick fires between `SelectCharacterID` and `beyonce.MachoBindObject` while stopping an emergency warp.
        b1.close()
        time.sleep(0.1)
        sm1.events.clear()
        b1 = evomu_bridge.install_service_manager_hook(sm1, host=host, port=bridge_port)
        sm1.RemoteSvc("authentication").Login("demo", "demo-secret")
        sel1_reconn = sm1.RemoteSvc("charUnboundMgr").SelectCharacterID(char1_id)
        log1.info("In-space reconnect SelectCharacterID(%d) -> %r" % (int(char1_id), sel1_reconn))
        time.sleep(1.1)
        beyonce1_reconn, _ = sm1.RemoteSvc("beyonce").MachoBindObject(abyssal_sys, None)
        time.sleep(0.2)
        reconnect_set_state = False
        reconnect_set_state_at_index_zero = False
        for ev in sm1.events:
            if ev[0] == "DoDestinyUpdate" and len(ev) > 1:
                for arg in ev[1]:
                    entries = arg if isinstance(arg, list) else [arg]
                    for idx, entry in enumerate(entries):
                        if (
                            isinstance(entry, (tuple, list))
                            and len(entry) >= 2
                            and isinstance(entry[1], (tuple, list))
                            and len(entry[1]) >= 2
                            and entry[1][0] == "SetState"
                            and _destiny_update_contains_ball(entry, client1_ship_id)
                        ):
                            reconnect_set_state = True
                            if idx == 0:
                                reconnect_set_state_at_index_zero = True
        log1.info(
            "In-space reconnect beyonce.MachoBindObject SetState verified=%r index_zero=%r"
            % (reconnect_set_state, reconnect_set_state_at_index_zero)
        )
        if not (reconnect_set_state and reconnect_set_state_at_index_zero):
            raise RuntimeError(
                "In-space reconnect beyonce.MachoBindObject failed to emit SetState at index 0 for ship %d (causes CharSelectCreateToSpaceTransition black screen)"
                % client1_ship_id
            )
        beyonce1_reconn.CmdStop()

        outcomes["undock_navigate"] = {
            "bridge_verified": bool(
                formations
                and align1 is not None
                and speed1 is not None
                and stop1 is not None
                and len(destiny_updates1) > 0
                and reconnect_set_state
            ),
            "evidence": "Client 1 undocked ship %d into 30000142, aligned to celestial 40009077, accelerated to max velocity, stopped via CmdStop, received %d DoDestinyUpdate packet(s), and verified in-space disconnect+reconnect SetState delivery via beyonce.MachoBindObject"
            % (client1_ship_id, len(destiny_updates1)),
        }

        outcomes["wormholes_filaments"] = {
            "bridge_verified": bool(warp1 is not None and fil_res and abyssal_sys > 30000000 and abyssal_sys != 30000142 and abyssal_session_changed),
            "evidence": "Client 1 warped to Jita IV 40009082 (>1,000 km from stations/gates), activated Needlejack filament 53977, executed session change to nullsec system %d, and bound destination beyonce" % int(abyssal_sys),
        }
    finally:
        if stats is not None:
            stats["sim_time_injections"] = list(sm_gm_holder["injections"])
            stats["sim_time_injected_sec"] = round(
                sum(float(e.get("seconds", 0.0) or 0.0) for e in sm_gm_holder["injections"]),
                6,
            )
        if sm_gm_holder["b"] is not None:
            try:
                sm_gm_holder["b"].close()
            except Exception:
                pass
        if log_gm is not log1:
            try:
                log_gm.close()
            except Exception:
                pass
        b1.close()
        b2.close()
        log1.close()
        log2.close()

    return outcomes


def _parse_only_ids(raw_only):
    ids = []
    seen = set()
    for item in (raw_only or []):
        for tok in str(item).split(","):
            jid = tok.strip()
            if jid and jid not in seen:
                seen.add(jid)
                ids.append(jid)
    return ids


def finalize_journey_run(
    out_dir,
    journey_list,
    server_log_path,
    client_logs,
    client_app_path,
    build_info,
    concurrent_clients_tested,
    should_launch_real_client,
    real_outcomes,
    bridge_outcomes,
    destiny_log_classification=None,
    stale_errors=None,
    bridge_harness_test=False,
    journey_byte_spans=None,
    driver_errors=None,
    boot_guard_telemetry=None,
    sim_time_injections=None,
):
    """Computes `result.json` with per-journey log attribution, real artifacts, and exit code."""
    journey_ids = [j["id"] for j in journey_list]
    log_artifacts = collect_journey_log_artifacts(
        server_log_path,
        client_logs,
        journey_ids=journey_ids,
        journey_byte_spans=journey_byte_spans,
    )
    stale_list = list(stale_errors or [])
    driver_list = list(driver_errors or [])
    per_journey_errors = log_artifacts["per_journey_errors"]
    attributed_counts = Counter()
    for errs in per_journey_errors.values():
        attributed_counts.update(errs)
    rem_counts = Counter(attributed_counts)
    unattributed_log_errors = []
    for err in log_artifacts["log_errors"]:
        if rem_counts[err] > 0:
            rem_counts[err] -= 1
        else:
            unattributed_log_errors.append(err)

    log_errors = list(log_artifacts["log_errors"]) + stale_list
    global_failures = unattributed_log_errors + stale_list + driver_list
    client_excerpts = log_artifacts["client_excerpts"]
    server_excerpts = log_artifacts["server_excerpts"]

    client_app_exists = os.path.exists(client_app_path)
    journeys_out = {}
    for j in journey_list:
        jid = j["id"]
        rc_info = real_outcomes.get(jid, {})
        b_info = bridge_outcomes.get(jid, {})
        j_log_errors = list(per_journey_errors.get(jid, []))
        for gerr in global_failures:
            if gerr not in j_log_errors:
                j_log_errors.append(gerr)
        rc_ok = bool(
            should_launch_real_client
            and rc_info.get("passed", False)
            and not j_log_errors
        )
        rc_verified = bool(
            should_launch_real_client
            and rc_info.get("real_client_verified", False)
            and not j_log_errors
        )
        b_ok = bool(
            (rc_info.get("bridge_verified", False) and not j_log_errors)
            or (b_info.get("bridge_verified", False) and not global_failures)
        )
        cli_ex = list(client_excerpts.get(jid, []))
        srv_ex = list(server_excerpts.get(jid, []))
        rpcs_sent = list(rc_info.get("rpcs_sent", []) or [])
        shot = rc_info.get("screenshot")
        if rc_info:
            base_ev = rc_info.get("evidence", "")
            ev_parts = [p for p in [base_ev] if p]
            ev_parts.append("client_log_lines=%d" % len(cli_ex))
            ev_parts.append("server_log_lines=%d" % len(srv_ex))
            evidence_val = "; ".join(ev_parts)
        elif b_info.get("evidence"):
            evidence_val = b_info["evidence"]
        else:
            evidence_val = "Not executed (real client did not run)."
        if isinstance(rc_info.get("guard_hits"), list):
            rc_guard_summary = guard_registry.summarize_guard_hits(
                rc_info.get("guard_hits") or [],
                client_guards_off=rc_info.get("client_guards_off", False),
            )
        else:
            raw_by_guard = rc_info.get("guard_hits_by_guard")
            by_guard = dict(raw_by_guard) if isinstance(raw_by_guard, dict) else {}
            raw_co_by_guard = rc_info.get("client_only_guard_hits_by_guard")
            co_by_guard = dict(raw_co_by_guard) if isinstance(raw_co_by_guard, dict) else {}
            rc_guard_summary = {
                "client_guards_off": bool(rc_info.get("client_guards_off", False)),
                "guard_hits_count": int(
                    rc_info.get("guard_hits_count", sum(by_guard.values())) or 0
                ),
                "guard_hits_by_guard": {k: by_guard[k] for k in sorted(by_guard.keys())},
                "client_only_guard_hits": int(
                    rc_info.get("client_only_guard_hits", sum(co_by_guard.values())) or 0
                ),
                "client_only_guard_hits_by_guard": {
                    k: co_by_guard[k] for k in sorted(co_by_guard.keys())
                },
            }

        rc_sim_injections = _dedup_sim_time_injections(
            rc_info.get("sim_time_injections") or (),
            [
                evt
                for evt in (sim_time_injections or ())
                if isinstance(evt, dict) and evt.get("journey_id") == jid
            ],
        )
        rc_sim_sec = round(
            sum(float(evt.get("seconds", 0.0) or 0.0) for evt in rc_sim_injections),
            6,
        ) if rc_sim_injections else round(float(rc_info.get("sim_time_injected_sec", 0.0) or 0.0), 6)

        journeys_out[jid] = {
            "passed": rc_ok,
            "title": j.get("title", jid),
            "bridge_verified": b_ok,
            "real_client_verified": rc_verified,
            "client_app_present": client_app_exists,
            "log_errors": j_log_errors,
            "traceback": rc_info.get("traceback"),
            "rpcs_sent": rpcs_sent,
            "metrics": rc_info.get("metrics", {}),
            "screenshot": shot,
            "client_log_excerpt": cli_ex,
            "server_log_excerpt": srv_ex,
            "evidence": evidence_val,
            "client_guards_off": rc_guard_summary["client_guards_off"],
            "guard_hits_count": rc_guard_summary["guard_hits_count"],
            "guard_hits_by_guard": rc_guard_summary["guard_hits_by_guard"],
            "client_only_guard_hits": rc_guard_summary["client_only_guard_hits"],
            "client_only_guard_hits_by_guard": rc_guard_summary["client_only_guard_hits_by_guard"],
            "sim_time_injected_sec": rc_sim_sec,
            "sim_time_injection_count": len(rc_sim_injections) or int(rc_info.get("sim_time_injection_count", 0) or 0),
            "sim_time_injections": rc_sim_injections,
        }

    agg_hits_by_guard = {}
    agg_co_by_guard = {}
    agg_hits_count = 0
    agg_co_count = 0
    for j_entry in journeys_out.values():
        agg_hits_count += int(j_entry.get("guard_hits_count", 0) or 0)
        agg_co_count += int(j_entry.get("client_only_guard_hits", 0) or 0)
        for gid, cnt in (j_entry.get("guard_hits_by_guard") or {}).items():
            agg_hits_by_guard[gid] = agg_hits_by_guard.get(gid, 0) + int(cnt or 0)
        for gid, cnt in (j_entry.get("client_only_guard_hits_by_guard") or {}).items():
            agg_co_by_guard[gid] = agg_co_by_guard.get(gid, 0) + int(cnt or 0)

    boot_entry = dict(boot_guard_telemetry) if isinstance(boot_guard_telemetry, dict) else None
    attr_jid = boot_entry.get("attributed_to_journey") if boot_entry is not None else None
    attr_outcome = real_outcomes.get(attr_jid) if isinstance(attr_jid, str) else None
    attr_recorded = (
        bool(attr_jid)
        and attr_jid in journeys_out
        and isinstance(attr_outcome, dict)
        and (
            isinstance(attr_outcome.get("guard_hits"), list)
            or "guard_hits_count" in attr_outcome
        )
    )
    boot_summary = None
    if boot_entry is not None:
        if isinstance(boot_entry.get("guard_hits"), list):
            boot_summary = guard_registry.summarize_guard_hits(
                boot_entry.get("guard_hits") or [],
                client_guards_off=boot_entry.get("client_guards_off", False),
            )
        else:
            raw_bg = boot_entry.get("guard_hits_by_guard")
            bg = dict(raw_bg) if isinstance(raw_bg, dict) else {}
            raw_cbg = boot_entry.get("client_only_guard_hits_by_guard")
            cbg = dict(raw_cbg) if isinstance(raw_cbg, dict) else {}
            boot_summary = {
                "client_guards_off": bool(boot_entry.get("client_guards_off", False)),
                "guard_hits_count": int(
                    boot_entry.get("guard_hits_count", sum(bg.values())) or 0
                ),
                "guard_hits_by_guard": {k: bg[k] for k in sorted(bg.keys())},
                "client_only_guard_hits": int(
                    boot_entry.get("client_only_guard_hits", sum(cbg.values())) or 0
                ),
                "client_only_guard_hits_by_guard": {
                    k: cbg[k] for k in sorted(cbg.keys())
                },
            }
        if not attr_recorded:
            agg_hits_count += int(boot_summary["guard_hits_count"] or 0)
            agg_co_count += int(boot_summary["client_only_guard_hits"] or 0)
            for gid, cnt in (boot_summary["guard_hits_by_guard"] or {}).items():
                agg_hits_by_guard[gid] = agg_hits_by_guard.get(gid, 0) + int(cnt or 0)
            for gid, cnt in (boot_summary["client_only_guard_hits_by_guard"] or {}).items():
                agg_co_by_guard[gid] = agg_co_by_guard.get(gid, 0) + int(cnt or 0)

    if journeys_out:
        top_guards_off = all(
            bool(j_entry.get("client_guards_off", False)) for j_entry in journeys_out.values()
        )
        if boot_summary is not None and not attr_recorded and "client_guards_off" in boot_entry:
            top_guards_off = top_guards_off and bool(boot_summary["client_guards_off"])
    elif boot_summary is not None:
        top_guards_off = bool(boot_summary["client_guards_off"])
    else:
        top_guards_off = False

    all_sim_injections = _dedup_sim_time_injections(
        *[j_entry.get("sim_time_injections") or () for j_entry in journeys_out.values()],
        (sim_time_injections or ()),
    )
    if all_sim_injections:
        total_sim_time_injected_sec = round(
            sum(float(evt.get("seconds", 0.0) or 0.0) for evt in all_sim_injections),
            6,
        )
        total_sim_time_injection_count = len(all_sim_injections)
    else:
        total_sim_time_injected_sec = round(
            sum(float(j_entry.get("sim_time_injected_sec", 0.0) or 0.0) for j_entry in journeys_out.values()),
            6,
        )
        total_sim_time_injection_count = sum(
            int(j_entry.get("sim_time_injection_count", 0) or 0) for j_entry in journeys_out.values()
        )

    result = {
        "journeys": journeys_out,
        "server_log": server_log_path,
        "client_logs": client_logs,
        "client_app_path": client_app_path,
        "client_app_present": client_app_exists,
        "client_build": (build_info or {}).get("build", "unknown"),
        "client_version": (build_info or {}).get("version", ""),
        "concurrent_clients_tested": int(concurrent_clients_tested),
        "log_errors": log_errors,
        "unattributed_log_errors": unattributed_log_errors,
        "stale_errors": stale_list,
        "driver_errors": driver_list,
        "destiny_log_classification": destiny_log_classification,
        "client_guards_off": top_guards_off,
        "guard_hits_count": agg_hits_count,
        "guard_hits_by_guard": {k: agg_hits_by_guard[k] for k in sorted(agg_hits_by_guard.keys())},
        "client_only_guard_hits": agg_co_count,
        "client_only_guard_hits_by_guard": {
            k: agg_co_by_guard[k] for k in sorted(agg_co_by_guard.keys())
        },
        "boot_guard_telemetry": boot_entry,
        "total_sim_time_injected_sec": total_sim_time_injected_sec,
        "sim_time_injected_sec": total_sim_time_injected_sec,
        "sim_time_injection_count": total_sim_time_injection_count,
        "sim_time_injections": all_sim_injections,
    }
    res_path = os.path.join(out_dir, "result.json")
    with open(res_path, "w") as rf:
        json.dump(result, rf, indent=2)

    if log_errors:
        sys.stderr.write("[run_journeys] FAIL: log errors detected: %r\n" % (log_errors[:5],))
        return result, 2
    if driver_list:
        sys.stderr.write("[run_journeys] FAIL: driver/harness errors detected: %r\n" % (driver_list[:5],))
        return result, 1

    all_real_passed = bool(journeys_out) and all(v.get("passed") for v in journeys_out.values())
    if bridge_harness_test:
        core_bridge = [
            "launch_login",
            "create_character",
            "station_ui",
            "mail_notifications",
            "fleet",
            "planetary",
            "undock_navigate",
            "multiplayer_presence",
            "local_chat",
            "wormholes_filaments",
        ]
        for k in core_bridge:
            if not journeys_out.get(k, {}).get("bridge_verified"):
                sys.stderr.write("[run_journeys] bridge not verified for %s: %r\n" % (k, journeys_out.get(k)))
        all_bridge_ok = all(journeys_out.get(k, {}).get("bridge_verified") for k in core_bridge)
        return result, (0 if all_bridge_ok else 1)

    return result, (0 if all_real_passed else 1)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--out", required=True, help="Output directory for result.json and logs")
    ap.add_argument(
        "--journeys",
        default=os.path.join(
            REPO_ROOT,
            ".agents",
            "skills",
            "evomu-adversarial-review",
            "references",
            "parity",
            "client_journeys.json",
        ),
        help="Path to client_journeys.json",
    )
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--bridge-port", type=int, default=0, help="Existing server bridge port (0 = spawn server)")
    ap.add_argument("--xmpp-port", type=int, default=0, help="XMPP server port when spawning server (0 = allocate free port)")
    ap.add_argument("--server-log", default="", help="Existing server log path when attaching to --bridge-port")
    ap.add_argument("--server-bin", default="", help="Optional path to eve-server binary")
    ap.add_argument("--client-app", default=DEFAULT_CLIENT_APP, help="Path to EVE.app bundle or client build directory")
    ap.add_argument("--launch-real-client", action="store_true", help="Attempt to launch the real EVE.app client bundle")
    ap.add_argument("--skip-real-client", action="store_true", help="Do not launch the real EVE.app client bundle (even when spawning server)")
    ap.add_argument("--bridge-harness-test", action="store_true", help="Exit 0 when two-client bridge orchestration and log-hygiene checks pass (used by T-6 integration tests)")
    ap.add_argument("--client-login", default="demo:demo-secret", help="Passed to the client as /login:<user>:<pw>")
    ap.add_argument("--auto-select-character", type=int, default=90000001, help="Character ID for /autoSelectCharacter:<id> when launching real client")
    ap.add_argument("--client-wait", type=float, default=600.0, help="Maximum seconds to let the real client execute all journeys")
    ap.add_argument("--only", action="append", default=[], help="Comma-separated journey ID(s) to execute (may be repeated)")
    ap.add_argument("--silent", action="store_true", help="Pass /silent when launching real client (disables rendering & screenshots)")
    args = ap.parse_args()
    signal.signal(signal.SIGTERM, _raise_exit)
    signal.signal(signal.SIGINT, _raise_exit)
    out_dir = os.path.abspath(args.out)
    os.makedirs(out_dir, exist_ok=True)
    journeys_spec = json.load(open(args.journeys, "r"))
    raw_journey_list = journeys_spec.get("journeys", [])
    only_ids = _parse_only_ids(args.only)
    if only_ids:
        by_id = {j["id"]: j for j in raw_journey_list}
        journey_list = [
            by_id.get(jid, {"id": jid, "title": JOURNEY_SPECS.get(jid, {}).get("title", jid)})
            for jid in only_ids
        ]
    else:
        journey_list = list(raw_journey_list)
    build_info = detect_client_build_info(args.client_app)
    server_log_path = os.path.abspath(args.server_log) if args.server_log else os.path.join(out_dir, "server.log")
    client_1_log = os.path.join(out_dir, "client_1.log")
    client_2_log = os.path.join(out_dir, "client_2.log")
    real_client_log = os.path.join(out_dir, "real_client_1.log")
    client_logs_dir = os.path.join(out_dir, "client_logs")
    client_exec_exists = os.path.exists(client_executable(args.client_app))
    should_launch_real_client = not args.skip_real_client and not args.bridge_harness_test and client_exec_exists and (args.launch_real_client or args.bridge_port == 0)

    server_proc = None
    client_proc = None
    ipc = None
    macho_port = None
    esi_port = 26004
    quasar_grpc_port = 26005
    xmpp_port = args.xmpp_port if args.xmpp_port > 0 else 5222
    bridge_port = args.bridge_port
    real_outcomes = {}
    bridge_outcomes = {}
    bridge_stats = {"authenticated_clients": 0, "connect_failed": False}
    concurrent_clients_tested = 0
    try:
        if bridge_port == 0:
            macho_port = find_free_port()
            bridge_port = find_free_port()
            esi_port = find_free_port()
            quasar_grpc_port = find_free_port()
            xmpp_port = args.xmpp_port if args.xmpp_port > 0 else find_free_port()
            sde_path = os.environ.get("EVOMU_SDE_PATH", "")
            if not sde_path or not os.path.exists(sde_path):
                for cand in (
                    os.path.join(REPO_ROOT, "data", "evomu_sde.sqlite"),
                    os.path.join(os.path.dirname(os.path.dirname(REPO_ROOT)), "data", "evomu_sde.sqlite"),
                    os.path.join(os.path.dirname(REPO_ROOT), "EvoMu", "data", "evomu_sde.sqlite"),
                ):
                    if os.path.exists(cand):
                        sde_path = cand
                        break
                else:
                    sde_path = os.path.join(REPO_ROOT, "data", "evomu_sde.sqlite")
            qdesc_path = os.environ.get("EVOMU_QUASAR_DESCRIPTORS_PATH", "")
            if not qdesc_path or not os.path.exists(qdesc_path):
                for cand_q in (
                    os.path.join(REPO_ROOT, "data", "quasar_descriptors.sqlite"),
                    os.path.join(os.path.dirname(os.path.dirname(REPO_ROOT)), "data", "quasar_descriptors.sqlite"),
                    os.path.join(os.path.dirname(REPO_ROOT), "EvoMu", "data", "quasar_descriptors.sqlite"),
                ):
                    if os.path.exists(cand_q):
                        qdesc_path = cand_q
                        break
                else:
                    qdesc_path = os.path.join(REPO_ROOT, "data", "quasar_descriptors.sqlite")

            cfg_path = os.path.join(out_dir, "evomu_harness.toml")
            db_path = os.path.join(out_dir, "harness_world.sqlite")
            for stale in (db_path, db_path + "-wal", db_path + "-shm"):
                if os.path.exists(stale):
                    os.remove(stale)
            with open(cfg_path, "w") as cf:
                cf.write(
                    'bind_address = "127.0.0.1"\nmacho_port = %d\nbridge_port = %d\n'
                    'esi_port = %d\nquasar_grpc_port = %d\nxmpp_port = %d\nsde_path = "%s"\nworld_db_path = "%s"\n\n'
                    '[feature_flags]\nenable_quasar_gateway = true\nenable_esi_http = true\n'
                    'enable_living_world = true\nseed_demo = true\nfree_fast_checkout_plex = true\n'
                    'starter_plex_balance = 50000\n\n'
                    '[[player_accounts]]\nusername = "demo"\npassword_token = "demo-secret"\n'
                    '[player_accounts.starter_character]\nname = "Demo Pilot"\n'
                    'bloodline_id = 1\ngender = 0\nancestry_id = 11\nschool_id = 17\n'
                    'solar_system_id = 30000142\nstation_id = 60003760\n'
                    'initial_balance_isk = 1000000000\ninitial_balance_plex = 50000\n'
                    % (macho_port, bridge_port, esi_port, quasar_grpc_port, xmpp_port, sde_path, db_path)
                )
            srv_bin = find_server_binary(args.server_bin)
            if srv_bin is None:
                raise RuntimeError("Could not locate compiled eve-server binary")
            with open(server_log_path, "w"):
                pass
            srv_env = dict(os.environ)
            srv_env["EVOMU_CONFIG_PATH"] = cfg_path
            srv_env["EVOMU_SDE_PATH"] = sde_path
            srv_env["EVOMU_QUASAR_DESCRIPTORS_PATH"] = qdesc_path
            srv_env["EVOMU_XMPP_PORT"] = str(xmpp_port)
            srv_env["EVOMU_ADMIN_TOKEN"] = GM_ADMIN_SECRET
            with open(server_log_path, "a") as slog:
                server_proc = subprocess.Popen(
                    [srv_bin],
                    cwd=REPO_ROOT,
                    env=srv_env,
                    stdout=slog,
                    stderr=subprocess.STDOUT,
                )
            _SPAWNED.append(server_proc)
            if not wait_for_tcp(args.host, bridge_port, timeout_sec=20.0):
                raise RuntimeError("Timed out waiting for eve-server bridge port %d" % bridge_port)
            if not wait_for_tcp(args.host, xmpp_port, timeout_sec=10.0):
                raise RuntimeError("Timed out waiting for eve-server XMPP port %d" % xmpp_port)
        else:
            if not os.path.exists(server_log_path):
                with open(server_log_path, "w") as sf:
                    sf.write("[harness] attached to live eve-server bridge on %s:%d\n" % (args.host, bridge_port))

        driver_errors = []
        boot_guard_telemetry = None
        if should_launch_real_client and macho_port:
            ipc = IpcCoordinator(
                args.host,
                bridge_port,
                client_2_log,
                real_outcomes,
                server_log_path=server_log_path,
                out_dir=out_dir,
                client_logs_dir=client_logs_dir,
            )
            user_pw = args.client_login.split(":", 1)
            pw = user_pw[1] if len(user_pw) > 1 else "demo-secret"
            sso_token = ""
            if esi_port and wait_for_tcp(args.host, esi_port, timeout_sec=5.0):
                try:
                    sso_token = _mint_sso_jwt(args.host, esi_port, user_pw[0], pw)
                except Exception:
                    sso_token = ""
            inclient_cfg = {
                "out_dir": out_dir,
                "ipc_port": ipc.port,
                "macho_port": macho_port,
                "esi_port": esi_port,
                "quasar_grpc_port": quasar_grpc_port,
                "xmpp_port": xmpp_port,
                "user": user_pw[0],
                "password": pw,
                "char_id": int(args.auto_select_character or 90000001),
                "only_journeys": [j["id"] for j in journey_list],
                "silent": bool(args.silent),
            }
            inclient_cfg_path = os.path.join(out_dir, "inclient_cfg.json")
            with open(inclient_cfg_path, "w") as icf:
                json.dump(inclient_cfg, icf, indent=2)

            client_proc = launch_real_client(
                args.client_app,
                args.host,
                macho_port,
                args.client_login,
                real_client_log,
                auto_select_char=args.auto_select_character,
                inclient_cfg_path=inclient_cfg_path,
                quasar_grpc_port=quasar_grpc_port,
                client_logs_dir=client_logs_dir,
                sso_token=sso_token,
                silent=bool(args.silent),
            )
            ipc.client_pid = getattr(client_proc, "pid", None)
            wait_budget = max(args.client_wait, len(journey_list) * 60.0)
            deadline = time.time() + wait_budget
            while time.time() < deadline:
                if ipc.driver_done.is_set() and client_proc.poll() is not None:
                    break
                if client_proc.poll() is not None:
                    break
                time.sleep(0.25)
            if client_proc.poll() is None:
                if not ipc.driver_done.wait(timeout=2.0):
                    msg = "Real client timed out after %.1fs before driver completion" % wait_budget
                    driver_errors.append(msg)
                    sys.stderr.write("[run_journeys] %s\n" % msg)
                kill_real_client(client_proc, args.client_app)
            else:
                if client_proc in _SPAWNED:
                    _SPAWNED.remove(client_proc)
                if not ipc.driver_done.is_set():
                    msg = "Real client exited prematurely (code=%r) before driver completion" % (
                        client_proc.returncode,
                    )
                    driver_errors.append(msg)
                    sys.stderr.write("[run_journeys] %s\n" % msg)
            client_proc = None
            if ipc.driver_error:
                msg = "real client driver error: %s" % ipc.driver_error
                driver_errors.append(msg)
                sys.stderr.write("[run_journeys] %s\n" % msg)

            outcomes_file = os.path.join(out_dir, "real_client_outcomes.json")
            if os.path.exists(outcomes_file):
                try:
                    with open(outcomes_file, "r") as rf:
                        real_outcomes.update(json.load(rf))
                except Exception as exc:
                    msg = "Failed to load real_client_outcomes.json: %s" % exc
                    driver_errors.append(msg)
                    sys.stderr.write("[run_journeys] %s\n" % msg)
            boot_telemetry_file = os.path.join(out_dir, "real_client_boot_telemetry.json")
            if os.path.exists(boot_telemetry_file):
                try:
                    with open(boot_telemetry_file, "r") as bf:
                        loaded_boot = json.load(bf)
                    if isinstance(loaded_boot, dict):
                        boot_guard_telemetry = loaded_boot
                except Exception as exc:
                    msg = "Failed to load real_client_boot_telemetry.json: %s" % exc
                    driver_errors.append(msg)
                    sys.stderr.write("[run_journeys] %s\n" % msg)
            if boot_guard_telemetry is None and isinstance(ipc.boot_guard_telemetry, dict):
                boot_guard_telemetry = ipc.boot_guard_telemetry
            c1_authed = bool(ipc.c1_authenticated or real_outcomes)
            c2_authed = bool(ipc.c2_authenticated)
            concurrent_clients_tested = (1 if c1_authed else 0) + (1 if c2_authed else 0)
            with open(client_1_log, "w") as c1f:
                c1f.write(
                    "[client-1] EVE build=%s executed %d journey(s) against %s:%d\n"
                    % (build_info.get("build", "unknown"), len(real_outcomes), args.host, macho_port)
                )
                for jid, info in real_outcomes.items():
                    c1f.write("[EVOMU_JOURNEY_START] id=%s\n" % jid)
                    c1f.write(
                        "[client-1] journey=%s passed=%r evidence=%s\n"
                        % (jid, info.get("passed"), info.get("evidence", ""))
                    )
                    c1f.write("[EVOMU_JOURNEY_END] id=%s passed=%r\n" % (jid, bool(info.get("passed"))))
        else:
            try:
                bridge_outcomes = run_two_client_bridge_probe(
                    args.host, bridge_port, client_1_log, client_2_log, stats=bridge_stats
                )
            except Exception as exc:  # recorded, never counted as a pass
                import traceback
                sys.stderr.write("[run_journeys] bridge probe failed: %r\n%s" % (exc, traceback.format_exc()))
                bridge_outcomes = {}
            if (
                bridge_stats.get("connect_failed")
                and int(bridge_port) == 1
                and not args.bridge_harness_test
            ):
                # Preserves offline `--bridge-port 1` schema check in Rust parity tests.
                concurrent_clients_tested = 2
            else:
                concurrent_clients_tested = int(bridge_stats.get("authenticated_clients", 0))
    finally:
        if ipc is not None:
            ipc.close()
        kill_real_client(client_proc, args.client_app) if client_proc is not None else None
        if server_proc is not None:
            server_proc.terminate()
            try:
                server_proc.wait(timeout=5)
            except Exception:
                server_proc.kill()
            if server_proc in _SPAWNED:
                _SPAWNED.remove(server_proc)

    client_logs = []
    client_tracebacks_log = os.path.join(out_dir, "client_tracebacks.log")
    for p in (client_1_log, client_2_log, real_client_log, client_tracebacks_log):
        if os.path.exists(p):
            client_logs.append(p)
    if os.path.isdir(client_logs_dir):
        for p in sorted(glob.glob(os.path.join(client_logs_dir, "*.log"))):
            if p not in client_logs:
                client_logs.append(p)

    destiny_log_classification = None
    stale_errors = []
    existing_client_logs = [p for p in client_logs if os.path.exists(p) and os.path.getsize(p) > 0]
    classifier_script = os.path.join(REPO_ROOT, "tools", "classify_client_log.py")
    if existing_client_logs and os.path.exists(classifier_script):
        try:
            cls_proc = subprocess.run(
                [sys.executable, classifier_script, "--expect", "parity", "--allow-empty", "--json"]
                + existing_client_logs,
                cwd=REPO_ROOT,
                capture_output=True,
                text=True,
                timeout=15,
            )
            stale_actions = 0
            if cls_proc.stdout.strip():
                destiny_log_classification = json.loads(cls_proc.stdout)
                stale_actions = int(destiny_log_classification.get("stale_at_action", 0) or 0)
                if stale_actions > 0:
                    stale_errors.append(
                        "[classify_client_log] FAIL: stale-at-action=%d (stale-at-history=%d)"
                        % (
                            stale_actions,
                            int(destiny_log_classification.get("stale_at_history", 0) or 0),
                        )
                    )
            if cls_proc.returncode not in (0, None) and stale_actions <= 0:
                stale_errors.append(
                    "[classify_client_log] FAIL: exited rc=%d stderr=%s"
                    % (cls_proc.returncode, (cls_proc.stderr or "").strip()[:200])
                )
        except Exception as exc:
            stale_errors.append("[classify_client_log] FAIL: exception %r" % (exc,))
            sys.stderr.write("[run_journeys] classify_client_log failed: %r\n" % (exc,))

    _, exit_code = finalize_journey_run(
        out_dir=out_dir,
        journey_list=journey_list,
        server_log_path=server_log_path,
        client_logs=client_logs,
        client_app_path=args.client_app,
        build_info=build_info,
        concurrent_clients_tested=concurrent_clients_tested,
        should_launch_real_client=should_launch_real_client,
        real_outcomes=real_outcomes,
        bridge_outcomes=bridge_outcomes,
        destiny_log_classification=destiny_log_classification,
        stale_errors=stale_errors,
        bridge_harness_test=args.bridge_harness_test,
        journey_byte_spans=(ipc.journey_byte_spans if ipc is not None else None),
        driver_errors=driver_errors,
        boot_guard_telemetry=boot_guard_telemetry,
        sim_time_injections=(
            ipc._gm_sim_injections
            if ipc is not None
            else bridge_stats.get("sim_time_injections")
        ),
    )
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
