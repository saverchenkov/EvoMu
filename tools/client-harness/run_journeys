        vgs_offers = sm1.RemoteSvc("storeManager").get_offers()
        assert isinstance(vgs_cats, list) and isinstance(vgs_prods, list) and isinstance(vgs_offers, list) and len(vgs_offers) >= 1
        nes_offer = next(
            (o for o in vgs_offers if any(int(p.get("typeID", 0)) > 0 for p in (getattr(o, "products", []) or []))),
