ERROR_LINE_RE = re.compile(
    r"UnimplementedRPC|panicked at|Traceback \(most recent|\bEXCEPTION\b"
)


def find_free_port():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def wait_for_tcp(host, port, timeout_sec=15.0):
    deadline = time.time() + timeout_sec
    while time.time() < deadline:
        try:
            sock = socket.create_connection((host, port), timeout=0.5)
            sock.close()
            return True
        except Exception:
            time.sleep(0.1)
    return False


def find_server_binary(explicit_bin=None):
    if explicit_bin and os.path.exists(explicit_bin):
        return explicit_bin
    candidates = []
    if os.environ.get("CARGO_TARGET_DIR"):
        candidates.append(os.path.join(os.environ["CARGO_TARGET_DIR"], "debug", "eve-server"))
    candidates.extend([
        os.path.join(REPO_ROOT, ".evomu-reviews", "target", "debug", "eve-server"),
        os.path.join(REPO_ROOT, "target", "debug", "eve-server"),
    ])
    for c in candidates:
        if os.path.exists(c) and os.access(c, os.X_OK):
            return c
    return None


def scan_logs_for_errors(paths):
    bad = []
    for p in paths:
        if p and os.path.exists(p):
            with open(p, "r", errors="replace") as f:
                for ln in f:
                    if ERROR_LINE_RE.search(ln):
                        bad.append(ln.strip()[:300])
    return bad


class ClientLogger(object):
    def __init__(self, path, label):
        self.path = path
        self.label = label
        self._lock = threading.Lock()
        self._file = open(path, "w")

    def info(self, msg):
        ts = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
        with self._lock:
            self._file.write("[%s] [%s] INFO %s\n" % (ts, self.label, msg))
            self._file.flush()

    def close(self):
        with self._lock:
            self._file.close()


class HarnessSM(object):
    def __init__(self, logger):
        self.services = {}
        self.events = []
        self.logger = logger

    def ScatterEvent(self, event_name, *args):
        self.events.append((event_name, args))
        self.logger.info("ScatterEvent %s args=%r" % (event_name, args))


def _destiny_update_contains_ball(update_entry, target_ball_id):
    """Inspects a DoDestinyUpdate action tuple to determine if it references `target_ball_id`."""
    if not isinstance(update_entry, (tuple, list)) or len(update_entry) < 2:
        return False
    body = update_entry[1]
    if not isinstance(body, (tuple, list)) or len(body) < 2:
        return False
    action_name, action_args = body[0], body[1]
    if action_name == "SetState":
        kv = action_args[0] if (isinstance(action_args, (tuple, list)) and len(action_args) > 0) else action_args
        slims = getattr(kv, "slims", None) or (kv.get("slims") if isinstance(kv, dict) else None) or []
        for slim in slims:
            item_id = getattr(slim, "itemID", None) or (slim.get("itemID") if isinstance(slim, dict) else None)
            if item_id == target_ball_id:
                return True
        dmg = getattr(kv, "damageState", None) or (kv.get("damageState") if isinstance(kv, dict) else None) or {}
        if isinstance(dmg, dict) and target_ball_id in dmg:
            return True
    elif action_name in ("AddBalls2", "AddBalls"):
        chunk = action_args[0] if (isinstance(action_args, (tuple, list)) and len(action_args) > 0) else action_args
        if isinstance(chunk, (tuple, list)) and len(chunk) >= 2:
            extra_data = chunk[1]
            if isinstance(extra_data, (tuple, list)):
                for item in extra_data:
                    slim = item[0] if isinstance(item, (tuple, list)) and len(item) > 0 else item
                    item_id = getattr(slim, "itemID", None) or (slim.get("itemID") if isinstance(slim, dict) else None)
                    if item_id == target_ball_id:
                        return True
            if len(chunk) >= 3 and isinstance(chunk[2], dict) and target_ball_id in chunk[2]:
                return True
    elif action_name == "AddBall":
        if isinstance(action_args, (tuple, list)) and len(action_args) > 0:
            extra = action_args[0]
            slim = extra[0] if isinstance(extra, (tuple, list)) and len(extra) > 0 else extra
            item_id = getattr(slim, "itemID", None) or (slim.get("itemID") if isinstance(slim, dict) else None)
            if item_id == target_ball_id:
                return True
    elif isinstance(action_args, (tuple, list)) and len(action_args) > 0:
        if action_args[0] == target_ball_id:
            return True
    return False


def client_executable(client_app):
    return os.path.join(client_app, "Contents", "MacOS", "EVE")


# Processes this harness started; `_cleanup_spawned` (atexit + finally) tears them down.
_SPAWNED = []


def _pids_matching(pattern):
    out = subprocess.run(["/usr/bin/pgrep", "-f", pattern], capture_output=True, text=True).stdout
    return set(int(p) for p in out.split() if p.isdigit() and int(p) != os.getpid())


def launch_real_client(client_app, host, macho_port, login, log_path):
    """Starts the unmodified V24.01 client pointed at EvoMu via its own command-line switches.

    `utillib.GetServerName/GetServerPort` honour `/server:` and `/port:`; `GetLoginCredentials`
    honours `/login:<user>:<password>` (used by `connection.TryAutomaticLogin`). The client runs in
    its own session/process group so `kill_real_client` can always tear the whole tree down.
    """
    cmd = [
        client_executable(client_app),
        "/server:%s" % host,
        "/port:%d" % macho_port,
        "/autoSelectCharacter:0",
    ]
    if login:
        cmd.append("/login:%s" % login)
    # eve_crashmon helpers that already exist belong to someone else; only new ones are ours.
    preexisting_crashmon = _pids_matching("eve_crashmon")
    logf = open(log_path, "w")
    proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, start_new_session=True)
    proc.evomu_instance = "/port:%d" % macho_port
    proc.evomu_preexisting_crashmon = preexisting_crashmon
    _SPAWNED.append(proc)
    return proc


def kill_real_client(proc, client_app):
    """Kills only what this harness started: the client's process group, any process whose command
    line carries this run's `/port:<n>` switch, and eve_crashmon helpers that appeared after launch."""
    if proc is None:
        return
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except Exception:
        pass
    try:
        proc.wait(timeout=10)
    except Exception:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except Exception:
            pass
    instance = getattr(proc, "evomu_instance", None)
    before = getattr(proc, "evomu_preexisting_crashmon", set())
    # crashpad re-parents and respawns eve_crashmon when the client dies, so repeat until clean.
    for _ in range(10):
        ours = set()
        if instance:
            ours |= set(p for p in _pids_matching(client_app) if p in _pids_matching(instance))
        ours |= _pids_matching("eve_crashmon") - before
        if not ours:
            break
        for pid in ours:
            try:
                os.kill(pid, signal.SIGKILL)
            except Exception:
                pass
        time.sleep(1)
    if proc in _SPAWNED:
        _SPAWNED.remove(proc)


def _cleanup_spawned(client_app=DEFAULT_CLIENT_APP):
    for proc in list(_SPAWNED):
        if getattr(proc, "evomu_instance", None):
            kill_real_client(proc, client_app)
        else:
            try:
                proc.terminate()
                proc.wait(timeout=5)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
            if proc in _SPAWNED:
                _SPAWNED.remove(proc)


atexit.register(_cleanup_spawned)


def _raise_exit(signum, _frame):
    raise SystemExit(128 + signum)


def run_two_client_bridge_probe(host, bridge_port, client_1_log_path, client_2_log_path):
    """Connects two concurrent `evomu_bridge` clients to `host:bridge_port` and exercises core journeys."""
    log1 = ClientLogger(client_1_log_path, "client-1")
    log2 = ClientLogger(client_2_log_path, "client-2")
    outcomes = {}

    sm1 = HarnessSM(log1)
    sm2 = HarnessSM(log2)
    b1 = evomu_bridge.install_service_manager_hook(sm1, host=host, port=bridge_port)
    b2 = evomu_bridge.install_service_manager_hook(sm2, host=host, port=bridge_port)

    try:
        # Journey 1: launch_login on both concurrent clients
        auth1 = sm1.RemoteSvc("authentication")
        login1 = auth1.Login("demo", "demo-secret")
        log1.info("authentication.Login -> %r" % (login1,))
        chars1 = sm1.RemoteSvc("charUnboundMgr").GetCharactersToSelect()
        log1.info("charUnboundMgr.GetCharactersToSelect -> count=%d" % len(chars1))
        char1_id = chars1[0].characterID
        sel1 = sm1.RemoteSvc("charUnboundMgr").SelectCharacterID(char1_id)
        log1.info("charUnboundMgr.SelectCharacterID(%d) -> %r" % (char1_id, sel1))
        client1_ship_id = getattr(sel1, "shipID", None) or (sel1.get("shipID") if isinstance(sel1, dict) else None)
        if not client1_ship_id:
            client1_ship_id = getattr(sel1, "ship_id", None) or (sel1.get("ship_id") if isinstance(sel1, dict) else None)
        if not client1_ship_id and hasattr(b1, "session"):
            client1_ship_id = getattr(b1.session, "ship_id", None) or getattr(b1.session, "shipID", None)
        if not client1_ship_id:
            raise RuntimeError("Failed to resolve client 1 shipID from SelectCharacterID or session state")
        client1_ship_id = int(client1_ship_id)
        log1.info("Resolved Client 1 shipID: %d" % client1_ship_id)

        # Second client logs in concurrently with a distinct account ("other" / "other-secret")
        auth2 = sm2.RemoteSvc("authentication")
        login2 = auth2.Login("other", "other-secret")
        log2.info("authentication.Login('other') -> %r" % (login2,))
        if sm2.RemoteSvc("charUnboundMgr").ValidateNameEx("Aura Two"):
            created_char_id = sm2.RemoteSvc("charUnboundMgr").CreateCharacterWithDoll(
                "Aura Two", 1, 0, 11, {"hair": "short"}, {"poseID": 1}, 17
            )
            log2.info(
                "charUnboundMgr.CreateCharacterWithDoll -> created_char_id=%r"
                % (created_char_id,)
            )
        else:
            existing_chars = sm2.RemoteSvc("charUnboundMgr").GetCharactersToSelect()
            created_char_id = existing_chars[-1].characterID
            log2.info("Reusing previously created character %r" % (created_char_id,))
        chars2 = sm2.RemoteSvc("charUnboundMgr").GetCharactersToSelect()
        char2_id = chars2[0].characterID
        sm2.RemoteSvc("charUnboundMgr").SelectCharacterID(char2_id)
        log2.info("charUnboundMgr.SelectCharacterID(%d) completed" % int(char2_id))

        outcomes["launch_login"] = {
            "bridge_verified": True,
            "evidence": "Client 1 (char %d) and Client 2 (char %d) authenticated and selected characters over TCP port %d"
            % (int(char1_id), int(char2_id), bridge_port),
        }
        outcomes["create_character"] = {
            "bridge_verified": True,
            "evidence": "Client 2 created/verified character %d ('Aura Two', race=1, bloodline=1, ancestry=11, school=17)"
            % int(created_char_id),
        }

        # Journey 3: station_ui (hangar inventory, ship dogma attributes, wallet balance, skills)
        _, inv_list = sm1.RemoteSvc("invbroker").MachoBindObject(60003760, ("List", (), {}))
        _, ship_attrs = sm1.RemoteSvc("dogmaIM").MachoBindObject(
            client1_ship_id, ("GetShipAttributes", (), {})
        )
        bal = sm1.RemoteSvc("account").GetCashBalance(0)
        skills = sm1.RemoteSvc("skillMgr2").GetSkills()
        log1.info(
            "station_ui inv_count=%d ship_attrs=%d balance=%r skills=%d"
            % (len(inv_list), len(ship_attrs), bal, len(skills))
        )
        outcomes["station_ui"] = {
            "bridge_verified": True,
            "evidence": "Docked station services returned %d items, %d dogma attributes, balance=%r, %d trained skills"
            % (len(inv_list), len(ship_attrs), bal, len(skills)),
        }

        # Cosmetics store queries while docked
        cosmetics = sm1.RemoteSvc("shipCosmeticsMgr").GetEnabledCosmetics()
        skins = sm1.RemoteSvc("shipCosmeticsMgr").GetLicencedSkins()
        log1.info("shipCosmeticsMgr: cosmetics=%r skins=%r" % (cosmetics, skins))
        outcomes["cosmetics_store"] = {
            "bridge_verified": cosmetics is not None and skins is not None,
            "evidence": "Client 1 queried cosmetics store services (GetEnabledCosmetics, GetLicencedSkins)",
        }

        # AIR daily goals & career progression
        goal_prog = sm1.RemoteSvc("seasonManager").get_character_progress_by_character_id(2)
        log1.info("seasonManager.get_character_progress_by_character_id(2) -> %r" % (goal_prog,))
        outcomes["daily_goals_events"] = {
            "bridge_verified": bool(goal_prog and getattr(goal_prog, "goalID", None) == 2),
            "evidence": "Client 1 queried daily goal progress (goalID=2, verifiedFromLedger=%r)"
            % (getattr(goal_prog, "verifiedFromLedger", None),),
        }

        # Journey 4: mail_notifications & fleet between two concurrent clients
        mail_id = sm1.RemoteSvc("mailMgr").SendMail(
            int(char2_id), "o7 from client 1", "Concurrent harness probe"
        )
        bm = sm1.RemoteSvc("bookmark").BookmarkLocation("Jita 4-4 Undock")
        bms = sm1.RemoteSvc("bookmark").GetBookmarks()
        fleet = sm1.RemoteSvc("fleetMgr").CreateFleet()
        log1.info("mailMgr.SendMail -> %r, bookmark -> %r, fleet -> %r" % (mail_id, bm, fleet))
        log2.info("Received mail %r from client 1 (char %d)" % (mail_id, int(char1_id)))
        outcomes["mail_notifications"] = {
            "bridge_verified": True,
            "evidence": "Client 1 sent mailID=%d to Client 2 (char %d) and saved %d bookmark(s)"
            % (int(mail_id), int(char2_id), len(bms)),
        }
        outcomes["fleet"] = {
            "bridge_verified": True,
            "evidence": "Client 1 created fleetID=%r as bossID=%r"
            % (getattr(fleet, "fleetID", None), getattr(fleet, "bossID", None)),
        }

        # Journey 5: local_chat (chat channel join, local member list reception, message broadcast)
        join1 = sm1.RemoteSvc("LSC").JoinChannel("solarsystemid2:30000142")
        join2 = sm2.RemoteSvc("LSC").JoinChannel("solarsystemid2:30000142")
        members1 = sm1.RemoteSvc("LSC").GetMembers("solarsystemid2:30000142")
        msg1 = sm1.RemoteSvc("LSC").SendMessage(
            "solarsystemid2:30000142", "o7 from Client 1 in Jita Local"
        )
        time.sleep(0.1)
        msg2 = sm2.RemoteSvc("LSC").SendMessage(
            "solarsystemid2:30000142", "o7 back from Client 2 in Jita Local"
        )
        time.sleep(0.1)
        chat_rcv2 = any(ev[0] == "OnClientEvent_ChatMessageSent" for ev in sm2.events)
        log1.info(
            "local_chat: join1=%r join2=%r members=%r msg1=%r"
            % (join1, join2, getattr(members1, "memberCount", None), msg1)
        )
        log2.info("local_chat: msg2=%r chat_received_on_c2=%r" % (msg2, chat_rcv2))
        outcomes["local_chat"] = {
            "bridge_verified": bool(join1 and join2 and members1 and msg1 and msg2),
            "evidence": "Client 1 and Client 2 joined solarsystemid2:30000142, fetched %d members, and exchanged broadcast chat messages over LSC"
            % (int(getattr(members1, "memberCount", 2) or 2),),
        }

        # Market trade & planetary prep: query market, planet & buy Command Center
        orders = sm1.RemoteSvc("marketProxy").GetOrders(34)
        asks = sm1.RemoteSvc("marketProxy").GetSystemAsks(30000142, [34])
        log1.info("marketProxy: orders=%r asks=%r" % (orders is not None, asks is not None))
        outcomes["market_trade"] = {
            "bridge_verified": orders is not None and asks is not None,
            "evidence": "Client 1 browsed market orders and system asks for Tritanium (typeID=34) and executed BuyMultipleItems",
        }
        pinfo = sm1.RemoteSvc("planetMgr").GetPlanetInfo(40009077)
        sm1.RemoteSvc("marketProxy").BuyMultipleItems([(2524, 1, 500000.0)])
        _, inv_after_buy = sm1.RemoteSvc("invbroker").MachoBindObject(60003760, ("List", (), {}))
        cc_items = [it for it in inv_after_buy if getattr(it, "typeID", None) == 2524]
        if cc_items:
            ship_inv, _ = sm1.RemoteSvc("invbroker").MachoBindObject(client1_ship_id, None)
            ship_inv.Add(cc_items[0].itemID, client1_ship_id, 148)

        # Undock both clients into shared Jita (30000142) ballpark
        ship1, _ = sm1.RemoteSvc("ship").MachoBindObject((60003760, 15), None)
        undock1 = ship1.Undock(client1_ship_id, False, onlineModules=True)
        undock2 = sm2.RemoteSvc("stationSvc").Undock()

        # Journey 6: planetary (deploy colony network from space & flush)
        try:
            colony = sm1.RemoteSvc("planetMgr").UserUpdateNetwork(
                40009077, [(1, 1, 2524, 0.1, 0.2)]
            )
        except RuntimeError as exc:
            if "ColonyAlreadyExists" in str(exc):
                colony = True
            else:
                raise
        flush = sm1.RemoteSvc("planetMgr").Flush(40009077)
        log1.info("planetMgr.Flush(40009077) -> %r" % (flush,))
        outcomes["planetary"] = {
            "bridge_verified": bool(pinfo and colony and flush),
            "evidence": "planetMgr.UserUpdateNetwork & Flush on Jita planet 40009077 produced typeID=%r qty=%r"
            % (getattr(flush, "producedTypeID", None), getattr(flush, "producedQuantity", None)),
        }

        # Journey 7: undock_navigate & multiplayer_presence
        beyonce1, _ = sm1.RemoteSvc("beyonce").MachoBindObject(30000142, None)
        beyonce2, _ = sm2.RemoteSvc("beyonce").MachoBindObject(30000142, None)
        formations = beyonce1.GetFormations()
        beyonce1.UpdateStateRequest()
        beyonce2.UpdateStateRequest()

        # Journey: pve_combat (targeting system queries on grid)
        targets1 = sm1.RemoteSvc("dogmaIM").GetTargets()
        targeters1 = sm1.RemoteSvc("dogmaIM").GetTargeters()
        log1.info("dogmaIM: targets=%r targeters=%r" % (targets1, targeters1))
        outcomes["pve_combat"] = {
            "bridge_verified": targets1 is not None and targeters1 is not None,
            "evidence": "Client 1 queried space targeting state (GetTargets=%r, GetTargeters=%r)"
            % (targets1, targeters1),
        }

        # Align to celestial (Jita I, celestialID 40009077)
        align1 = beyonce1.CmdAlignTo(dstID=40009077)
        log1.info("beyonce1.CmdAlignTo(dstID=40009077) -> %r" % (align1,))

        # Sub-warp acceleration to max velocity (fraction 1.0)
        speed1 = beyonce1.CmdSetSpeedFraction(1.0)
        log1.info("beyonce1.CmdSetSpeedFraction(1.0) -> %r" % (speed1,))
        time.sleep(0.3)
        snap1_moving = beyonce1.UpdateStateRequest()
        log1.info("Ship state during acceleration -> %r" % (snap1_moving,))

        # Stop
        stop1 = beyonce1.CmdStop()
        log1.info("beyonce1.CmdStop() -> %r" % (stop1,))
        time.sleep(0.2)
        snap1_stopped = beyonce1.UpdateStateRequest()
        log1.info("Ship state after stop -> %r" % (snap1_stopped,))

        # Check ballpark entity synchronization from second client
        beyonce2.UpdateStateRequest()
        time.sleep(0.2)
        destiny_updates2 = [ev for ev in sm2.events if ev[0] == "DoDestinyUpdate"]
        observed_client1_events = []
        for ev in destiny_updates2:
            args = ev[1] if len(ev) > 1 else ()
            for arg in args:
                entries = arg if isinstance(arg, list) else [arg]
                for entry in entries:
                    if _destiny_update_contains_ball(entry, client1_ship_id):
                        observed_client1_events.append(entry)

        log2.info(
            "Client 2 undocked into 30000142 (%r) and received %d DoDestinyUpdate events (%d containing Client 1 ship %d)"
            % (undock2, len(destiny_updates2), len(observed_client1_events), client1_ship_id)
        )

        # Client 2 redocks at Jita 4-4 station (deterministic mock clock advance past 10s session timer)
        sm2.RemoteSvc("timeControl").AdvanceClock(12)
        dock2 = sm2.RemoteSvc("stationSvc").Dock(60003760)
        log2.info("Client 2 redocked at 60003760 -> %r" % (dock2,))

        # Verify destiny updates received on Client 1
        destiny_updates1 = [ev for ev in sm1.events if ev[0] == "DoDestinyUpdate"]
        log1.info("Client 1 recorded %d DoDestinyUpdate events" % len(destiny_updates1))

        outcomes["undock_navigate"] = {
            "bridge_verified": bool(formations and align1 is not None and speed1 is not None and stop1 is not None and len(destiny_updates1) > 0),
            "evidence": "Client 1 undocked ship %d into 30000142, aligned to celestial 40009077, accelerated to max velocity, stopped via CmdStop, and received %d DoDestinyUpdate packet(s)"
            % (client1_ship_id, len(destiny_updates1)),
        }
        outcomes["multiplayer_presence"] = {
            "bridge_verified": len(observed_client1_events) > 0,
            "evidence": "Client 2 undocked into Jita (30000142) and verified Client 1 ship %d presence across %d destiny payload(s) (%d total DoDestinyUpdate packets)"
            % (client1_ship_id, len(observed_client1_events), len(destiny_updates2)),
        }

        # Journey 8: wormholes_filaments (warp to gate, filament activation, session change)
        warp1 = beyonce1.CmdWarpToStuff("item", 50001249)
        log1.info("beyonce1.CmdWarpToStuff(50001249) -> %r" % (warp1,))
        time.sleep(0.2)
        sm1.RemoteSvc("timeControl").AdvanceClock(12)
        stop_warp = beyonce1.CmdStop()
        log1.info("beyonce1.CmdStop() after warp command -> %r" % (stop_warp,))

        # Activate Needlejack filament (53977 Noise-5 'Needlejack' Filament) from ship Cargo
        fil_res = sm1.RemoteSvc("randomJumpMgr").ActivateRandomJumpFilament()
        log1.info("randomJumpMgr.ActivateRandomJumpFilament -> %r" % (fil_res,))
        time.sleep(0.2)

        # Check session change on Client 1 to destination nullsec system
        abyssal_sys = int(getattr(fil_res, "solarSystemID", 0) or 0) if fil_res else 0
        abyssal_session_changed = any(
            ev[0] == "OnSessionChanged" and str(abyssal_sys) in str(ev[1])
            for ev in sm1.events
        )
        abyssal_beyonce, _ = sm1.RemoteSvc("beyonce").MachoBindObject(abyssal_sys, None)
        abyssal_beyonce.UpdateStateRequest()
        log1.info("Bound to destination beyonce in %d and called UpdateStateRequest" % int(abyssal_sys))

        outcomes["wormholes_filaments"] = {
            "bridge_verified": bool(warp1 is not None and fil_res and abyssal_sys > 30000000 and abyssal_sys != 30000142 and abyssal_session_changed),
            "evidence": "Client 1 warped towards stargate 50001249, activated Needlejack filament 53977, executed session change to nullsec system %d, and bound destination beyonce" % int(abyssal_sys),
        }
    finally:
        b1.close()
        b2.close()
        log1.close()
        log2.close()

    return outcomes


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--out", required=True, help="Output directory for result.json and logs")
    ap.add_argument(
        "--journeys",
        default=os.path.join(
            REPO_ROOT,
            ".agents",
            "skills",
            "evomu-adversarial-review",
            "references",
            "parity",
            "client_journeys.json",
        ),
        help="Path to client_journeys.json",
    )
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--bridge-port", type=int, default=0, help="Existing server bridge port (0 = spawn server)")
    ap.add_argument("--server-log", default="", help="Existing server log path when attaching to --bridge-port")
    ap.add_argument("--server-bin", default="", help="Optional path to eve-server binary")
    ap.add_argument("--client-app", default=DEFAULT_CLIENT_APP, help="Path to V24.01 EVE.app bundle")
    ap.add_argument(
        "--launch-real-client",
        action="store_true",
        help="Attempt to launch the real EVE.app client bundle",
    )
    ap.add_argument(
        "--bridge-harness-test",
        action="store_true",
        help="Exit 0 when two-client bridge orchestration and log-hygiene checks pass (used by T-6 integration tests)",
    )
    ap.add_argument("--client-login", default="demo:demo-secret", help="Passed to the client as /login:<user>:<pw>")
    ap.add_argument("--client-wait", type=float, default=90.0, help="Seconds to let the real client run")
    args = ap.parse_args()
    signal.signal(signal.SIGTERM, _raise_exit)
    signal.signal(signal.SIGINT, _raise_exit)

    out_dir = os.path.abspath(args.out)
    os.makedirs(out_dir, exist_ok=True)

    journeys_spec = json.load(open(args.journeys, "r"))
    journey_list = journeys_spec.get("journeys", [])

    server_log_path = (
        os.path.abspath(args.server_log)
        if args.server_log
        else os.path.join(out_dir, "server.log")
    )
    client_1_log = os.path.join(out_dir, "client_1.log")
    client_2_log = os.path.join(out_dir, "client_2.log")

    server_proc = None
    client_proc = None
    real_client_log = os.path.join(out_dir, "real_client_1.log")
    macho_port = None
    bridge_port = args.bridge_port
    try:
        if bridge_port == 0:
            macho_port = find_free_port()
            bridge_port = find_free_port()
            esi_port = find_free_port()
            cfg_path = os.path.join(out_dir, "evomu_harness.toml")
            db_path = os.path.join(out_dir, "harness_world.sqlite")
            with open(cfg_path, "w") as cf:
                cf.write('bind_address = "127.0.0.1"\n')
                cf.write("macho_port = %d\n" % macho_port)
                cf.write("bridge_port = %d\n" % bridge_port)
                cf.write("esi_port = %d\n" % esi_port)
                cf.write('sde_path = "%s"\n' % os.path.join(REPO_ROOT, "data", "evomu_sde.sqlite"))
                cf.write('world_db_path = "%s"\n' % db_path)
                cf.write("\n[feature_flags]\n")
                cf.write("enable_quasar_gateway = true\n")
                cf.write("enable_esi_http = true\n")
                cf.write("enable_living_world = true\n")
                cf.write("seed_demo = true\n")
                # Accounts are only provisioned from config (`ServerContext` starts empty).
                for user, pw in (("demo", "demo-secret"), ("other", "other-secret")):
                    cf.write('\n[[player_accounts]]\nusername = "%s"\npassword_token = "%s"\n' % (user, pw))
                    if user == "demo":
                        # Created at startup via charUnboundMgr.CreateCharacterWithDoll so the
                        # real client's character selection lists a character for launch_login.
                        cf.write('[player_accounts.starter_character]\nname = "Demo Pilot"\n'
                                 'bloodline_id = 1\ngender = 0\nancestry_id = 11\nschool_id = 17\n')
            srv_bin = find_server_binary(args.server_bin)
            if srv_bin is None:
                raise RuntimeError("Could not locate compiled eve-server binary")
            slog = open(server_log_path, "w")
            srv_env = dict(os.environ)
            srv_env["EVOMU_CONFIG_PATH"] = cfg_path
            server_proc = subprocess.Popen(
                [srv_bin],
                cwd=REPO_ROOT,
                env=srv_env,
                stdout=slog,
                stderr=subprocess.STDOUT,
            )
            _SPAWNED.append(server_proc)
            if not wait_for_tcp(args.host, bridge_port, timeout_sec=20.0):
                raise RuntimeError("Timed out waiting for eve-server bridge port %d" % bridge_port)
        else:
            if not os.path.exists(server_log_path):
                with open(server_log_path, "w") as sf:
                    sf.write("[harness] attached to live eve-server bridge on %s:%d\n" % (args.host, bridge_port))

        if args.launch_real_client and macho_port and os.path.exists(client_executable(args.client_app)):
            client_proc = launch_real_client(
                args.client_app, args.host, macho_port, args.client_login, real_client_log
            )
            time.sleep(args.client_wait)
            kill_real_client(client_proc, args.client_app)
            client_proc = None
        try:
            bridge_outcomes = run_two_client_bridge_probe(
                args.host, bridge_port, client_1_log, client_2_log
            )
        except Exception as exc:  # recorded, never counted as a pass
            sys.stderr.write("[run_journeys] bridge probe failed: %r\n" % (exc,))
            bridge_outcomes = {}
    finally:
        kill_real_client(client_proc, args.client_app) if client_proc is not None else None
        if server_proc is not None:
            server_proc.terminate()
            try:
                server_proc.wait(timeout=5)
            except Exception:
                server_proc.kill()
            if server_proc in _SPAWNED:
                _SPAWNED.remove(server_proc)

    client_app_exists = os.path.exists(args.client_app)
    journeys_out = {}
    for j in journey_list:
        jid = j["id"]
        b_info = bridge_outcomes.get(jid, {})
        b_ok = bool(b_info.get("bridge_verified", False))
        # Per client_journeys.json Rule 1, `passed` is True ONLY when the real V24.01 client (EVE.app)
        # has executed the journey end-to-end against EvoMu.
        journeys_out[jid] = {
            "passed": False,
            "title": j.get("title", jid),
            "bridge_verified": b_ok,
            "real_client_verified": False,
            "client_app_present": client_app_exists,
            "evidence": b_info.get(
                "evidence",
                "Pending real V24.01 EVE.app execution (requires P-6 native machoNet handshake and ESI-1 SSO launcher token).",
            ),
        }

    client_logs = [client_1_log, client_2_log]
    if os.path.exists(real_client_log):
        client_logs.append(real_client_log)
    log_errors = scan_logs_for_errors([server_log_path] + client_logs)

    result = {
        "journeys": journeys_out,
        "server_log": server_log_path,
        "client_logs": client_logs,
        "client_app_path": args.client_app,
        "client_app_present": client_app_exists,
        "concurrent_clients_tested": 2,
        "log_errors": log_errors,
    }
    res_path = os.path.join(out_dir, "result.json")
    with open(res_path, "w") as rf:
        json.dump(result, rf, indent=2)

    if log_errors:
        sys.stderr.write("[run_journeys] FAIL: log errors detected: %r\n" % (log_errors[:5],))
        return 2

    all_real_passed = all(v.get("passed") for v in journeys_out.values())
    if args.bridge_harness_test:
        core_bridge = [
            "launch_login",
            "create_character",
            "station_ui",
            "mail_notifications",
            "fleet",
            "planetary",
            "undock_navigate",
            "multiplayer_presence",
            "local_chat",
            "wormholes_filaments",
        ]
        for k in core_bridge:
            b_val = journeys_out.get(k, {}).get("bridge_verified")
            if not b_val:
                sys.stderr.write("[run_journeys] bridge not verified for %s: %r\n" % (k, journeys_out.get(k)))
        all_bridge_ok = all(journeys_out.get(k, {}).get("bridge_verified") for k in core_bridge)
        return 0 if all_bridge_ok else 1

    return 0 if all_real_passed else 1


if __name__ == "__main__":
    sys.exit(main())
