        for svc_name, method_name, rpc_args in [
            ("machoNet", "GetTime", ()),
            ("config", "GetMultiOwnersEx", ([int(char1_id)],)),
            ("config", "GetMultiLocationsEx", ([30000142, 60003760],)),
            ("config", "GetBlackListedPlanets", ()),
            ("config", "GetAverageMarketPrices", ()),
            ("config", "GetOldStationData", ()),
            ("invbroker", "GetItemDescriptor", ()),
            ("air_npe", "is_air_npe_enabled", ()),
            ("charUnboundMgr", "GetCharacterSelectionData", ()),
            ("charUnboundMgr", "GetCohortsForUser", ()),
            ("charUnboundMgr", "GetCharOmegaDowngradeStatus", ()),
            ("userSvc", "GetRedeemTokens", ()),
            ("map", "GetSecurityModifiedSystems", ()),
            ("populationCap", "GetCharacterLoadSlot", (int(char1_id),)),
            ("charMgr", "GetCharacterSettings", ()),
            ("charMgr", "GetPaperdollState", ()),
            ("structureDirectory", "GetMyDockableStructures", (30000142,)),
            ("skillMgr2", "GetAttributes", ()),
            ("skillMgr2", "GetFreeSkillPoints", ()),
            ("operationsManager", "can_character_play_the_tutorial", ()),
            ("seasonManager", "get_season_data_for_character", ()),
            ("XmppChatMgr", "GetDeprecatedPrefsFallback", ()),
            ("onlineStatus", "GetInitialState", ()),
            ("scanMgr", "SignalTrackerRegister", ()),
            ("insurgencySolarsystem", "GetAllVisibleCampaigns", ()),
            ("essMgr", "GetDataForClientSolarSystem", (30000142,)),
            ("dynamicBountyMgr", "GetOutputForClientSolarSystem", (30000142,)),
            ("fwWarzoneSolarsystem", "GetLocalOccupationState", (30000142,)),
        ]:
            try:
                res = getattr(sm1.RemoteSvc(svc_name), method_name)(*rpc_args)
                log1.info("startup RPC %s.%s -> %s" % (svc_name, method_name, type(res).__name__))
            except Exception as exc:
                startup_rpcs_ok = False
                log1.info("startup RPC %s.%s FAILED: %r" % (svc_name, method_name, exc))
