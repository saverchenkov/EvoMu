            _probe_advance_clock(12, int(char2_id), journey_id="create_character")
            b2_nav, _ = sm2.RemoteSvc("beyonce").MachoBindObject(30000142, None)
            try:
                b2_nav.CmdWarpToStuff("item", 60003760)
                _probe_advance_clock(60, int(char2_id), journey_id="create_character")
            except Exception:
                pass
            sm2.RemoteSvc("stationSvc").Dock(60003760)
        except Exception as exc:
            log2.info("optional /tr 30000142 skipped: %r" % (exc,))

        outcomes["launch_login"] = {
            "bridge_verified": bool(startup_rpcs_ok),
            "evidence": "Client 1 (char %d) and Client 2 (char %d) authenticated, selected characters, and verified 28 post-login startup RPCs over TCP port %d"
            % (int(char1_id), int(char2_id), bridge_port),
        }
        outcomes["create_character"] = {
            "bridge_verified": True,
            "evidence": "Client 2 created/verified character %d ('Aura Two', race=1, bloodline=1, ancestry=11, school=17)"
            % int(created_char_id),
        }

        # Journey 3: station_ui (hangar inventory, ship dogma attributes, wallet balance, skills, assets stations, direct skill purchase)
        _, inv_list = sm1.RemoteSvc("invbroker").MachoBindObject(60003760, ("List", (), {}))
