        assert int(getattr(nes_buy, "offerID", 0)) == nes_offer_id
        assert int(getattr(nes_buy, "plexSpent", 0)) == nes_price
        assert int(getattr(nes_buy, "plexRemaining", -1)) == new_plex_bal - nes_price
        delivered_item_id = int(getattr(nes_buy, "deliveredItemID", 0))
        assert delivered_item_id > 0
        nes_products = getattr(nes_offer, "products", [])
        delivered_type_id = int(nes_products[0].get("typeID", 34599)) if nes_products else 34599
        sm1.RemoteSvc("shipCosmeticsMgr").ActivateSkinLicense(delivered_type_id)
        skins = sm1.RemoteSvc("shipCosmeticsMgr").GetLicencedSkins()
        cosmetics = sm1.RemoteSvc("shipCosmeticsMgr").GetEnabledCosmetics()
