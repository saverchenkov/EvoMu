        beyonce2.UpdateStateRequest()
        time.sleep(0.2)
        destiny_updates2 = [ev for ev in sm2.events if ev[0] == "DoDestinyUpdate"]
        observed_client1_events = []
        for ev in destiny_updates2:
            args = ev[1] if len(ev) > 1 else ()
            for arg in args:
                entries = arg if isinstance(arg, list) else [arg]
                for entry in entries:
                    if _destiny_update_contains_ball(entry, client1_ship_id):
                        observed_client1_events.append(entry)

        log2.info(
            "Client 2 undocked into 30000142 (%r) and received %d DoDestinyUpdate events (%d containing Client 1 ship %d)"
            % (undock2, len(destiny_updates2), len(observed_client1_events), client1_ship_id)
        )

        # Client 2 redocks at Jita 4-4 station (deterministic mock clock advance past 10s session timer)
        beyonce2.CmdStop()
        sm2.RemoteSvc("timeControl").AdvanceClock(12)
        dock2 = sm2.RemoteSvc("stationSvc").Dock(60003760)
        log2.info("Client 2 redocked at 60003760 -> %r" % (dock2,))

        # Verify destiny updates received on Client 1
        destiny_updates1 = [ev for ev in sm1.events if ev[0] == "DoDestinyUpdate"]
        log1.info("Client 1 recorded %d DoDestinyUpdate events" % len(destiny_updates1))

        outcomes["multiplayer_presence"] = {
            "bridge_verified": len(observed_client1_events) > 0,
            "evidence": "Client 2 undocked into Jita (30000142) and verified Client 1 ship %d presence across %d destiny payload(s) (%d total DoDestinyUpdate packets)"
            % (client1_ship_id, len(observed_client1_events), len(destiny_updates2)),
        }

        # Journey 8: wormholes_filaments (warp >1,000 km off stations/gates to Jita IV 40009082, filament activation, session change)
        warp1 = beyonce1.CmdWarpToStuff("item", 40009082)
        log1.info("beyonce1.CmdWarpToStuff(40009082) -> %r" % (warp1,))
        time.sleep(0.2)
        sm1.RemoteSvc("timeControl").AdvanceClock(28)
        stop_warp = beyonce1.CmdStop()
        log1.info("beyonce1.CmdStop() after warp command -> %r" % (stop_warp,))

        # Activate Needlejack filament (53977 Noise-5 'Needlejack' Filament) from ship Cargo
        try:
            sm1.RemoteSvc("slash").SlashCmd("/createitem 53977 1")
        except Exception:
            pass
        fil_res = sm1.RemoteSvc("randomJumpMgr").ActivateRandomJumpFilament()
        log1.info("randomJumpMgr.ActivateRandomJumpFilament -> %r" % (fil_res,))
        time.sleep(0.2)

        # Check session change on Client 1 to destination nullsec system
        abyssal_sys = int(getattr(fil_res, "solarSystemID", 0) or 0) if fil_res else 0
        abyssal_session_changed = any(
            ev[0] == "OnSessionChanged" and str(abyssal_sys) in str(ev[1])
            for ev in sm1.events
        )
        abyssal_beyonce, _ = sm1.RemoteSvc("beyonce").MachoBindObject(abyssal_sys, None)
        abyssal_beyonce.UpdateStateRequest()
        log1.info("Bound to destination beyonce in %d and called UpdateStateRequest" % int(abyssal_sys))

        # Verify in-space disconnect + reconnect (`SelectCharacterID` -> `beyonce.MachoBindObject` WITHOUT
        # `UpdateStateRequest`, matching V24.01 `Michelle.AddBallpark` -> `Park.InitializeRemoteBallpark`)
        # delivers `SetState` at index 0 (`state[0][1][0] == "SetState"`) via `DoDestinyUpdate` even when
        # a 1Hz tick fires between `SelectCharacterID` and `beyonce.MachoBindObject` while stopping an emergency warp.
        b1.close()
        time.sleep(0.1)
        sm1.events.clear()
        b1 = evomu_bridge.install_service_manager_hook(sm1, host=host, port=bridge_port)
        sm1.RemoteSvc("authentication").Login("demo", "demo-secret")
        sel1_reconn = sm1.RemoteSvc("charUnboundMgr").SelectCharacterID(char1_id)
        log1.info("In-space reconnect SelectCharacterID(%d) -> %r" % (int(char1_id), sel1_reconn))
        time.sleep(1.1)
        beyonce1_reconn, _ = sm1.RemoteSvc("beyonce").MachoBindObject(abyssal_sys, None)
        time.sleep(0.2)
        reconnect_set_state = False
        reconnect_set_state_at_index_zero = False
        for ev in sm1.events:
            if ev[0] == "DoDestinyUpdate" and len(ev) > 1:
                for arg in ev[1]:
                    entries = arg if isinstance(arg, list) else [arg]
                    for idx, entry in enumerate(entries):
                        if (
                            isinstance(entry, (tuple, list))
                            and len(entry) >= 2
                            and isinstance(entry[1], (tuple, list))
                            and len(entry[1]) >= 2
                            and entry[1][0] == "SetState"
                            and _destiny_update_contains_ball(entry, client1_ship_id)
                        ):
                            reconnect_set_state = True
                            if idx == 0:
                                reconnect_set_state_at_index_zero = True
        log1.info(
            "In-space reconnect beyonce.MachoBindObject SetState verified=%r index_zero=%r"
            % (reconnect_set_state, reconnect_set_state_at_index_zero)
        )
        if not (reconnect_set_state and reconnect_set_state_at_index_zero):
            raise RuntimeError(
                "In-space reconnect beyonce.MachoBindObject failed to emit SetState at index 0 for ship %d (causes V24.01 CharSelectCreateToSpaceTransition black screen)"
                % client1_ship_id
            )
        beyonce1_reconn.CmdStop()

        outcomes["undock_navigate"] = {
            "bridge_verified": bool(
                formations
                and align1 is not None
                and speed1 is not None
                and stop1 is not None
                and len(destiny_updates1) > 0
                and reconnect_set_state
            ),
            "evidence": "Client 1 undocked ship %d into 30000142, aligned to celestial 40009077, accelerated to max velocity, stopped via CmdStop, received %d DoDestinyUpdate packet(s), and verified in-space disconnect+reconnect SetState delivery via beyonce.MachoBindObject"
            % (client1_ship_id, len(destiny_updates1)),
        }

        outcomes["wormholes_filaments"] = {
            "bridge_verified": bool(warp1 is not None and fil_res and abyssal_sys > 30000000 and abyssal_sys != 30000142 and abyssal_session_changed),
            "evidence": "Client 1 warped to Jita IV 40009082 (>1,000 km from stations/gates), activated Needlejack filament 53977, executed session change to nullsec system %d, and bound destination beyonce" % int(abyssal_sys),
        }
    finally:
        b1.close()
        b2.close()
        log1.close()
        log2.close()

    return outcomes


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--out", required=True, help="Output directory for result.json and logs")
    ap.add_argument(
        "--journeys",
        default=os.path.join(
            REPO_ROOT,
            ".agents",
            "skills",
            "evomu-adversarial-review",
            "references",
            "parity",
            "client_journeys.json",
        ),
        help="Path to client_journeys.json",
    )
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--bridge-port", type=int, default=0, help="Existing server bridge port (0 = spawn server)")
    ap.add_argument("--xmpp-port", type=int, default=0, help="XMPP server port when spawning server (0 = allocate free port)")
    ap.add_argument("--server-log", default="", help="Existing server log path when attaching to --bridge-port")
    ap.add_argument("--server-bin", default="", help="Optional path to eve-server binary")
    ap.add_argument("--client-app", default=DEFAULT_CLIENT_APP, help="Path to V24.01 EVE.app bundle")
    ap.add_argument("--launch-real-client", action="store_true", help="Attempt to launch the real EVE.app client bundle")
    ap.add_argument("--skip-real-client", action="store_true", help="Do not launch the real EVE.app client bundle (even when spawning server)")
    ap.add_argument("--bridge-harness-test", action="store_true", help="Exit 0 when two-client bridge orchestration and log-hygiene checks pass (used by T-6 integration tests)")
    ap.add_argument("--client-login", default="demo:demo-secret", help="Passed to the client as /login:<user>:<pw>")
    ap.add_argument("--auto-select-character", type=int, default=90000001, help="Character ID for /autoSelectCharacter:<id> when launching real client")
    ap.add_argument("--client-wait", type=float, default=600.0, help="Maximum seconds to let the real client execute all journeys")
    args = ap.parse_args()
    signal.signal(signal.SIGTERM, _raise_exit)
    signal.signal(signal.SIGINT, _raise_exit)
    out_dir = os.path.abspath(args.out)
    os.makedirs(out_dir, exist_ok=True)
    journeys_spec = json.load(open(args.journeys, "r"))
    journey_list = journeys_spec.get("journeys", [])
    server_log_path = os.path.abspath(args.server_log) if args.server_log else os.path.join(out_dir, "server.log")
    client_1_log = os.path.join(out_dir, "client_1.log")
    client_2_log = os.path.join(out_dir, "client_2.log")
    real_client_log = os.path.join(out_dir, "real_client_1.log")
    client_logs_dir = os.path.join(out_dir, "client_logs")
    client_exec_exists = os.path.exists(client_executable(args.client_app))
    should_launch_real_client = not args.skip_real_client and not args.bridge_harness_test and client_exec_exists and (args.launch_real_client or args.bridge_port == 0)

    server_proc = None
    client_proc = None
    ipc = None
    macho_port = None
    esi_port = 26004
    quasar_grpc_port = 26005
    xmpp_port = args.xmpp_port if args.xmpp_port > 0 else 5222
    bridge_port = args.bridge_port
    real_outcomes = {}
    bridge_outcomes = {}
    try:
        if bridge_port == 0:
            macho_port = find_free_port()
            bridge_port = find_free_port()
            esi_port = find_free_port()
            quasar_grpc_port = find_free_port()
            xmpp_port = args.xmpp_port if args.xmpp_port > 0 else find_free_port()
            sde_path = os.environ.get("EVOMU_SDE_PATH", "")
            if not sde_path or not os.path.exists(sde_path):
                cand = os.path.join(REPO_ROOT, "data", "evomu_sde.sqlite")
                sde_path = cand if os.path.exists(cand) else "/Users/sergeya/ai/EvoMu/data/evomu_sde.sqlite"
            qdesc_path = os.environ.get("EVOMU_QUASAR_DESCRIPTORS_PATH", "")
            if not qdesc_path or not os.path.exists(qdesc_path):
                cand_q = os.path.join(REPO_ROOT, "data", "quasar_descriptors.sqlite")
                qdesc_path = cand_q if os.path.exists(cand_q) else "/Users/sergeya/ai/EvoMu/data/quasar_descriptors.sqlite"

            cfg_path = os.path.join(out_dir, "evomu_harness.toml")
            db_path = os.path.join(out_dir, "harness_world.sqlite")
            for stale in (db_path, db_path + "-wal", db_path + "-shm"):
                if os.path.exists(stale):
                    os.remove(stale)
            with open(cfg_path, "w") as cf:
                cf.write(
                    'bind_address = "127.0.0.1"\nmacho_port = %d\nbridge_port = %d\n'
                    'esi_port = %d\nquasar_grpc_port = %d\nxmpp_port = %d\nsde_path = "%s"\nworld_db_path = "%s"\n\n'
                    '[feature_flags]\nenable_quasar_gateway = true\nenable_esi_http = true\n'
                    'enable_living_world = true\nseed_demo = true\nfree_fast_checkout_plex = true\n'
                    'starter_plex_balance = 50000\n\n'
                    '[[player_accounts]]\nusername = "demo"\npassword_token = "demo-secret"\n'
                    '[player_accounts.starter_character]\nname = "Demo Pilot"\n'
                    'bloodline_id = 1\ngender = 0\nancestry_id = 11\nschool_id = 17\n'
                    'solar_system_id = 30000142\nstation_id = 60003760\n'
                    'initial_balance_isk = 1000000000\ninitial_balance_plex = 50000\n\n'
                    '[[admin_accounts]]\nusername = "demo"\npassword_token = "demo-secret"\n'
                    'character_id = 90000001\ncharacter_name = "Demo Pilot"\n\n'
                    '[[admin_accounts]]\nusername = "other"\npassword_token = "other-secret"\n'
                    'character_id = 90000004\ncharacter_name = "ISD Other"\n'
                    % (macho_port, bridge_port, esi_port, quasar_grpc_port, xmpp_port, sde_path, db_path)
                )
            srv_bin = find_server_binary(args.server_bin)
            if srv_bin is None:
                raise RuntimeError("Could not locate compiled eve-server binary")
            slog = open(server_log_path, "w")
            srv_env = dict(os.environ)
            srv_env["EVOMU_CONFIG_PATH"] = cfg_path
            srv_env["EVOMU_SDE_PATH"] = sde_path
            srv_env["EVOMU_QUASAR_DESCRIPTORS_PATH"] = qdesc_path
            srv_env["EVOMU_XMPP_PORT"] = str(xmpp_port)
            server_proc = subprocess.Popen(
                [srv_bin],
                cwd=REPO_ROOT,
                env=srv_env,
                stdout=slog,
                stderr=subprocess.STDOUT,
            )
            _SPAWNED.append(server_proc)
            if not wait_for_tcp(args.host, bridge_port, timeout_sec=20.0):
                raise RuntimeError("Timed out waiting for eve-server bridge port %d" % bridge_port)
            if not wait_for_tcp(args.host, xmpp_port, timeout_sec=10.0):
                raise RuntimeError("Timed out waiting for eve-server XMPP port %d" % xmpp_port)
        else:
            if not os.path.exists(server_log_path):
                with open(server_log_path, "w") as sf:
                    sf.write("[harness] attached to live eve-server bridge on %s:%d\n" % (args.host, bridge_port))

        if should_launch_real_client and macho_port:
            ipc = IpcCoordinator(args.host, bridge_port, client_2_log, real_outcomes)
            user_pw = args.client_login.split(":", 1)
            pw = user_pw[1] if len(user_pw) > 1 else "demo-secret"
            sso_token = ""
            if esi_port and wait_for_tcp(args.host, esi_port, timeout_sec=5.0):
                try:
                    sso_token = _mint_sso_jwt(args.host, esi_port, user_pw[0], pw)
                except Exception:
                    sso_token = ""
            inclient_cfg = {
                "out_dir": out_dir,
                "ipc_port": ipc.port,
                "macho_port": macho_port,
                "esi_port": esi_port,
                "quasar_grpc_port": quasar_grpc_port,
                "xmpp_port": xmpp_port,
                "user": user_pw[0],
                "password": pw,
                "char_id": int(args.auto_select_character or 90000001),
                "only_journeys": [j["id"] for j in journey_list] if len(journey_list) < 29 else None,
            }
            inclient_cfg_path = os.path.join(out_dir, "inclient_cfg.json")
            with open(inclient_cfg_path, "w") as icf:
                json.dump(inclient_cfg, icf, indent=2)

            client_proc = launch_real_client(
                args.client_app,
                args.host,
                macho_port,
                args.client_login,
                real_client_log,
                auto_select_char=args.auto_select_character,
                inclient_cfg_path=inclient_cfg_path,
                quasar_grpc_port=quasar_grpc_port,
                client_logs_dir=client_logs_dir,
                sso_token=sso_token,
            )
            deadline = time.time() + max(args.client_wait, len(journey_list) * 60.0)
            while time.time() < deadline:
                if ipc.driver_done.is_set() and client_proc.poll() is not None:
                    break
                if client_proc.poll() is not None:
                    break
                time.sleep(0.25)
            if client_proc.poll() is None:
                ipc.driver_done.wait(timeout=2.0)
                kill_real_client(client_proc, args.client_app)
            elif client_proc in _SPAWNED:
                _SPAWNED.remove(client_proc)
            client_proc = None
            if ipc.driver_error:
                sys.stderr.write("[run_journeys] real client driver error: %s\n" % ipc.driver_error)

            outcomes_file = os.path.join(out_dir, "real_client_outcomes.json")
            if os.path.exists(outcomes_file):
                try:
                    with open(outcomes_file, "r") as rf:
                        real_outcomes.update(json.load(rf))
                except Exception:
                    pass
            with open(client_1_log, "w") as c1f:
                c1f.write("[client-1] Real V24.01 exefile executed %d journey(s) against %s:%d\n" % (
                    len(real_outcomes), args.host, macho_port
                ))
                for jid, info in real_outcomes.items():
                    c1f.write("[client-1] journey=%s passed=%r evidence=%s\n" % (
                        jid, info.get("passed"), info.get("evidence", "")
                    ))
        else:
            try:
                bridge_outcomes = run_two_client_bridge_probe(
                    args.host, bridge_port, client_1_log, client_2_log
                )
            except Exception as exc:  # recorded, never counted as a pass
                import traceback
                sys.stderr.write("[run_journeys] bridge probe failed: %r\n%s" % (exc, traceback.format_exc()))
                bridge_outcomes = {}
    finally:
        if ipc is not None:
            ipc.close()
        kill_real_client(client_proc, args.client_app) if client_proc is not None else None
        if server_proc is not None:
            server_proc.terminate()
            try:
                server_proc.wait(timeout=5)
            except Exception:
                server_proc.kill()
            if server_proc in _SPAWNED:
                _SPAWNED.remove(server_proc)

    client_logs = []
    client_tracebacks_log = os.path.join(out_dir, "client_tracebacks.log")
    for p in (client_1_log, client_2_log, real_client_log, client_tracebacks_log):
        if os.path.exists(p):
            client_logs.append(p)
    if os.path.isdir(client_logs_dir):
        for p in sorted(glob.glob(os.path.join(client_logs_dir, "*.log"))):
            if p not in client_logs:
                client_logs.append(p)
    log_errors = scan_logs_for_errors([server_log_path] + client_logs)

    client_app_exists = os.path.exists(args.client_app)
    journeys_out = {}
    for j in journey_list:
        jid = j["id"]
        rc_info = real_outcomes.get(jid, {})
        b_info = bridge_outcomes.get(jid, {})
        rc_ok = bool(should_launch_real_client and rc_info.get("passed", False) and not log_errors)
        b_ok = bool(rc_info.get("bridge_verified", False) or b_info.get("bridge_verified", False))
        journeys_out[jid] = {
            "passed": rc_ok,
            "title": j.get("title", jid),
            "bridge_verified": b_ok,
            "real_client_verified": bool(should_launch_real_client and rc_info.get("real_client_verified", False)),
            "client_app_present": client_app_exists,
            "evidence": (
                rc_info.get("evidence")
                if rc_info.get("evidence")
                else b_info.get(
                    "evidence",
                    "Pending real V24.01 EVE.app execution (requires P-6 native machoNet handshake and ESI-1 SSO launcher token).",
