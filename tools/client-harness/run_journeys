        assert skill_chg_evs and len(skill_chg_evs[-1][1]) == 3, "OnServerSkillsChanged must pass 3 positional arguments (skillInfos, event, timeStamp)"
        log1.info(
            "station_ui inv_count=%d ship_attrs=%d balance=%r skills=%d stations=%d"
            % (len(inv_list), len(ship_attrs), bal, len(skills), len(stations_list))
