def _append_log_line(path, line):
    if not path:
        return
    try:
        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        try:
            os.write(fd, line.encode("utf-8"))
        finally:
            os.close(fd)
    except Exception:
        pass


def find_free_port():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def wait_for_tcp(host, port, timeout_sec=15.0):
    deadline = time.time() + timeout_sec
    while time.time() < deadline:
        try:
            sock = socket.create_connection((host, port), timeout=0.5)
            sock.close()
            return True
        except Exception:
            time.sleep(0.1)
    return False


def find_server_binary(explicit_bin=None):
    if explicit_bin and os.path.exists(explicit_bin):
        return explicit_bin
    candidates = []
    if os.environ.get("CARGO_TARGET_DIR"):
        candidates.append(os.path.join(os.environ["CARGO_TARGET_DIR"], "debug", "eve-server"))
    candidates.extend([
        os.path.join(REPO_ROOT, "target", "debug", "eve-server"),
        os.path.join(REPO_ROOT, ".evomu-reviews", "target", "debug", "eve-server"),
    ])
    existing = [c for c in candidates if os.path.exists(c) and os.access(c, os.X_OK)]
    if existing:
        existing.sort(key=lambda p: os.path.getmtime(p), reverse=True)
        return existing[0]
    return None


def _resolve_span_jid(spans, offset):
    for start_off, end_off, span_jid in spans or ():
        if start_off <= offset < end_off:
            return span_jid
    return None


def scan_logs_for_journey_errors(
    paths,
    journey_ids=None,
    max_excerpt_lines=40,
    journey_byte_spans=None,
):
    """Scans log files and attributes ERROR_LINE_RE matches & excerpts to intervals or byte spans.

    Returns dict with keys:
      - `log_errors`: full whole-run list of error lines
      - `per_journey_errors`: `{jid: [err_lines...]}`
      - `per_journey_excerpts`: `{jid: [excerpt_lines...]}`
    """
    run_errors = []
    per_journey_errors = {jid: [] for jid in (journey_ids or [])}
    per_journey_excerpts = {jid: [] for jid in (journey_ids or [])}
    span_map = journey_byte_spans or {}
    for p in paths:
        if not (p and os.path.exists(p)):
            continue
        file_spans = span_map.get(os.path.realpath(p)) or span_map.get(p) or ()
        seen_client_started = False
        active_jid = None
        offset = 0
        with open(p, "rb") as f:
            for raw in f:
                line_start = offset
                offset += len(raw)
                ln = raw.decode("utf-8", "replace")
                m_start = JOURNEY_START_RE.search(ln)
                if m_start:
                    active_jid = m_start.group(1)
                    per_journey_errors.setdefault(active_jid, [])
                    per_journey_excerpts.setdefault(active_jid, [])
                    continue
                m_end = JOURNEY_END_RE.search(ln)
                if m_end:
                    if active_jid == m_end.group(1) or active_jid is None:
                        active_jid = None
                    continue
                if "EVE Client version" in ln and "started" in ln:
                    seen_client_started = True
                eff_jid = active_jid if active_jid is not None else _resolve_span_jid(file_spans, line_start)
                if eff_jid is not None:
                    per_journey_errors.setdefault(eff_jid, [])
                    per_journey_excerpts.setdefault(eff_jid, [])
                stripped = ln.rstrip("\r\n")
                if eff_jid is not None and stripped:
                    buf = per_journey_excerpts[eff_jid]
                    if len(buf) < max_excerpt_lines:
                        buf.append(stripped[:300])
                if ERROR_LINE_RE.search(ln) or (
                    seen_client_started and "#nolog: An exception has occurred" in ln
                ):
                    err_txt = ln.strip()[:300]
                    run_errors.append(err_txt)
                    if eff_jid is not None:
                        per_journey_errors[eff_jid].append(err_txt)
    return {
        "log_errors": run_errors,
        "per_journey_errors": per_journey_errors,
        "per_journey_excerpts": per_journey_excerpts,
    }


def collect_journey_log_artifacts(
    server_log_path,
    client_log_paths,
    journey_ids=None,
    journey_byte_spans=None,
):
    """Combines server and client log attribution into run-level errors plus per-journey errors & excerpts."""
    srv_scan = scan_logs_for_journey_errors(
        [server_log_path] if server_log_path else [],
        journey_ids=journey_ids,
        journey_byte_spans=journey_byte_spans,
    )
    cli_scan = scan_logs_for_journey_errors(
        client_log_paths or [],
        journey_ids=journey_ids,
        journey_byte_spans=journey_byte_spans,
    )
    all_jids = list(journey_ids or [])
    for jid in list(srv_scan["per_journey_errors"].keys()) + list(cli_scan["per_journey_errors"].keys()):
        if jid not in all_jids:
            all_jids.append(jid)
    per_journey_errors = {}
    client_excerpts = {}
    server_excerpts = {}
    for jid in all_jids:
        per_journey_errors[jid] = (
            srv_scan["per_journey_errors"].get(jid, [])
            + cli_scan["per_journey_errors"].get(jid, [])
        )
        client_excerpts[jid] = cli_scan["per_journey_excerpts"].get(jid, [])
        server_excerpts[jid] = srv_scan["per_journey_excerpts"].get(jid, [])
    return {
        "log_errors": srv_scan["log_errors"] + cli_scan["log_errors"],
        "per_journey_errors": per_journey_errors,
        "client_excerpts": client_excerpts,
        "server_excerpts": server_excerpts,
    }


def scan_logs_for_errors(paths):
    return scan_logs_for_journey_errors(paths)["log_errors"]


class ClientLogger(object):
    def __init__(self, path, label):
        self.path = path
        self.label = label
        self._lock = threading.Lock()
        self._file = open(path, "w")

    def info(self, msg):
        ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        with self._lock:
            self._file.write("[%s] [%s] INFO %s\n" % (ts, self.label, msg))
            self._file.flush()

    def close(self):
        with self._lock:
            self._file.close()


