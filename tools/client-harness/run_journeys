        outcomes["station_ui"] = {
            "bridge_verified": True,
            "evidence": "Docked station services returned %d items, %d dogma attributes, balance=%r, %d trained skills, %d asset stations, and verified PurchaseSkills + 3-arg OnServerSkillsChanged"
