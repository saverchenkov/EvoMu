def _is_gm_transport_error(exc):
    if isinstance(exc, (OSError, EOFError)):
        return True
    if isinstance(exc, RuntimeError):
        msg = str(exc or "")
        low = msg.lower()
        if "evomu rpc error [" in low:
            return False
        return (
            "bridge connection failed:" in low
            or "not connected" in low
            or "connection closed" in low
        )
    return False


def _dedup_sim_time_injections(*batches):
    merged = []
    seen_ids = set()
    for batch in batches:
        for evt in (batch or ()):
            if not isinstance(evt, dict):
                continue
            eid = evt.get("injection_id")
            if eid:
                key = ("id", str(eid))
                if key in seen_ids:
                    continue
                seen_ids.add(key)
            merged.append(dict(evt))
    return merged
