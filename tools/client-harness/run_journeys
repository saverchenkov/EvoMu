        fc_buy3 = sm1.RemoteSvc("FastCheckoutService").BuyOffer(int(third_pack["offerId"]), 1)
        assert fc_buy3.get("status") == "COMPLETED"
        new_plex_bal = int(fc_buy3["newPlexBalance"])
