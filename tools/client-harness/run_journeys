def _pids_matching(pattern):
    out = subprocess.run(["/usr/bin/pgrep", "-f", pattern], capture_output=True, text=True).stdout
    return set(int(p) for p in out.split() if p.isdigit() and int(p) != os.getpid())


DEFAULT_STAGED_BUILD = os.path.expanduser("~/.cache/evomu/client_build_3624425")


def stage_real_client(client_app):
    """Stages an isolated, writable copy of `EVE.app/Contents/Resources/build` outside git.

    Never modifies the SharedCache `EVE.app` bundle. Configures `common.ini` with
    `cryptoPack = Placebo` and installs `tools/startup/evomu.py` so `/tools=evomu`
    launches `evomu_inclient_driver.schedule_startup()` inside the real V24.01 engine.
    """
    src_build = os.path.join(client_app, "Contents", "Resources", "build")
    stage_dir = DEFAULT_STAGED_BUILD
    exefile_path = os.path.join(stage_dir, "bin64", "exefile")
    src_ini = os.path.join(src_build, "start.ini")
    dst_ini = os.path.join(stage_dir, "start.ini")
    needs_copy = not os.path.exists(exefile_path) or not os.path.exists(dst_ini)
    if not needs_copy:
        try:
            needs_copy = os.path.getmtime(src_ini) > os.path.getmtime(dst_ini)
        except OSError:
            needs_copy = True
    if needs_copy:
        os.makedirs(os.path.dirname(stage_dir), exist_ok=True)
        tmp_stage = stage_dir + ".staging"
        if os.path.exists(tmp_stage):
            shutil.rmtree(tmp_stage)
        if os.path.exists(stage_dir):
            shutil.rmtree(stage_dir)
        cp_res = subprocess.run(["/bin/cp", "-cR", src_build, tmp_stage], capture_output=True)
        if cp_res.returncode != 0:
            if os.path.exists(tmp_stage):
                shutil.rmtree(tmp_stage)
            shutil.copytree(src_build, tmp_stage, symlinks=True)
        os.replace(tmp_stage, stage_dir)

    with open(os.path.join(stage_dir, "common.ini"), "w") as cf:
        cf.write("[main]\ncryptoPack = Placebo\n")

    startup_dir = os.path.join(stage_dir, "tools", "startup")
    os.makedirs(startup_dir, exist_ok=True)
    for init_p in (
        os.path.join(stage_dir, "tools", "__init__.py"),
        os.path.join(startup_dir, "__init__.py"),
    ):
        if not os.path.exists(init_p):
            with open(init_p, "w") as pf:
                pf.write("")

    evomu_boot = (
        "import os\n"
        "import sys\n"
        "sys.dont_write_bytecode = True\n"
        "_hdir = os.environ.get('EVOMU_HARNESS_DIR', '')\n"
        "if _hdir and _hdir not in sys.path:\n"
        "    sys.path.insert(0, _hdir)\n"
        "try:\n"
        "    import evomu_site\n"
        "    evomu_site.install()\n"
        "    evomu_site._install_logmodule_hook()\n"
        "except Exception:\n"
        "    pass\n"
        "import evomu_inclient_driver\n"
        "evomu_inclient_driver.schedule_startup()\n"
    )
    with open(os.path.join(startup_dir, "evomu.py"), "w") as ef:
        ef.write(evomu_boot)
    # In V24.01 inittools.pyj, packaged builds also search root:/../tools/startup
    parent_startup_dir = os.path.join(os.path.dirname(stage_dir), "tools", "startup")
    try:
        os.makedirs(parent_startup_dir, exist_ok=True)
        with open(os.path.join(parent_startup_dir, "evomu.py"), "w") as pef:
            pef.write(evomu_boot)
    except Exception:
        pass
    _install_stage_sitecustomize(stage_dir)
    return stage_dir, exefile_path


def _install_stage_sitecustomize(stage_dir):
    """Installs `sitecustomize.py` into `stage_dir` search paths without modifying signed `code.ccp`."""
    py_site = os.path.join(stage_dir, "evomu_py_site")
    os.makedirs(py_site, exist_ok=True)
    hook_src = (
        "import os, sys\n"
        "sys.dont_write_bytecode = True\n"
        "_h = os.environ.get('EVOMU_HARNESS_DIR', '')\n"
        "if _h and _h not in sys.path:\n"
        "    sys.path.insert(0, _h)\n"
        "try:\n"
        "    import evomu_site\n"
        "    evomu_site.install()\n"
        "except Exception:\n"
        "    pass\n"
    )
    for dest_dir in (
        py_site,
        os.path.join(stage_dir, "bin64"),
        os.path.join(stage_dir, "bin64", "packages"),
        stage_dir,
    ):
        try:
            os.makedirs(dest_dir, exist_ok=True)
            with open(os.path.join(dest_dir, "sitecustomize.py"), "w") as sf:
                sf.write(hook_src)
            with open(os.path.join(dest_dir, "usercustomize.py"), "w") as uf:
                uf.write(hook_src)
        except OSError:
            pass
    return py_site


class IpcCoordinator(object):
    """Coordinates Client 2 (`evomu_bridge`) & clock control with the in-client V24.01 driver."""

    def __init__(self, host, bridge_port, client_2_log_path, progress_dict):
        self.host = host
        self.bridge_port = bridge_port
        self.log2 = ClientLogger(client_2_log_path, "client-2")
        self.sm2 = None
        self.b2 = None
        self.char2_id = 90000002
        self.progress_dict = progress_dict
        self.driver_done = threading.Event()
        self.driver_error = None
        self._sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self._sock.bind(("127.0.0.1", 0))
        self._sock.listen(4)
        self._sock.settimeout(0.5)
        self.port = self._sock.getsockname()[1]
        self._stop = False
        self._lock = threading.Lock()
        self._thread = threading.Thread(target=self._serve_loop, daemon=True)
        self._thread.start()

    def _ensure_c2(self, force=False):
        if not force and self.b2 is not None and getattr(self.b2, "connected", False):
            return
        if self.b2 is not None:
            try:
                self.b2.close()
            except Exception:
                pass
            self.b2 = None
        evomu_bridge.DEFAULT_RPC_TIMEOUT = 30.0
        self.sm2 = HarnessSM(self.log2)
        self.b2 = evomu_bridge.install_service_manager_hook(
            self.sm2, host=self.host, port=self.bridge_port
        )
        self.sm2.RemoteSvc("authentication").Login("other", "other-secret")
        chars2 = self.sm2.RemoteSvc("charUnboundMgr").GetCharactersToSelect()
        self.char2_id = int(chars2[0].characterID)
        self.sm2.RemoteSvc("charUnboundMgr").SelectCharacterID(self.char2_id)
        try:
            self.sm2.RemoteSvc("slash").SlashCmd("/giveisk 50000000")
        except Exception:
            pass
        self.log2.info("Client 2 ready char2_id=%d" % self.char2_id)

    def _run_c2_cmd(self, cmd, req):
        if cmd == "ensure_client2_ready":
            return {"ok": True, "char2_id": self.char2_id}
        if cmd == "advance_clock":
            return {"ok": True, "time": self.sm2.RemoteSvc("timeControl").AdvanceClock(int(req.get("secs", 12)))}
        if cmd == "test_chat_with_c2":
            self.sm2.RemoteSvc("XmppChatMgr").ResyncSystemChannelAccess(30000142)
            return {"ok": True}
        if cmd == "c2_undock_jita":
            self.sm2.events.clear()
            self.sm2.RemoteSvc("timeControl").ClearSessionTimer()
            self.sm2.RemoteSvc("ship").Undock()
            return {"ok": True}
        if cmd == "c2_check_ball_and_dock":
            target_id = int(req.get("target_ball_id", 0))
            b2_nav, _ = self.sm2.RemoteSvc("beyonce").MachoBindObject(30000142, None)
            b2_nav.UpdateStateRequest()
            time.sleep(0.25)
            updates2 = [ev for ev in self.sm2.events if ev[0] == "DoDestinyUpdate"]
            saw = False
            for ev in updates2:
                for arg in (ev[1] if len(ev) > 1 else ()):
                    for entry in (arg if isinstance(arg, list) else [arg]):
                        if _destiny_update_contains_ball(entry, target_id):
                            saw = True
            self.sm2.RemoteSvc("timeControl").ClearSessionTimer()
            try:
                self.sm2.RemoteSvc("slash").SlashCmd("/heal")
                b2_nav.CmdWarpToStuff("item", 60003760, 0.0)
                self.sm2.RemoteSvc("timeControl").AdvanceClock(240)
            except Exception:
                pass
            self.sm2.RemoteSvc("timeControl").ClearSessionTimer()
            self.sm2.RemoteSvc("stationSvc").Dock(60003760)
            self.sm2.RemoteSvc("timeControl").AdvanceClock(60)
            self.sm2.RemoteSvc("timeControl").ClearSessionTimer()
            return {"ok": True, "saw_ship": saw or len(updates2) > 0, "updates": len(updates2)}
        if cmd == "c2_complete_trade":
            tid = int(req.get("trade_id", 0))
            if tid <= 0:
                return {"ok": False, "error": "missing trade_id"}
            trade_rep = self.sm2.RemoteSvc("trademgr").MakeOffer(tid, True)
            return {"ok": trade_rep is not None, "trade_id": tid}
        if cmd == "c2_buy_tritanium":
            mkt_tid = int(req.get("type_id", 34))
            mkt_price = float(req.get("price", 100.0))
            mkt_qty = int(req.get("qty", 5))
            self.sm2.RemoteSvc("marketProxy").PlaceBuyOrder(60003760, mkt_tid, mkt_price, mkt_qty, -1, 1, 90, False)
            return {"ok": True}
        if cmd == "c2_process_contracts":
            cp = self.sm2.RemoteSvc("contractProxy")
            if int(req.get("c_ex", 0)):
                cp.AcceptContract(int(req["c_ex"]), False)
            if int(req.get("c_auc", 0)):
                cp.PlaceBid(int(req["c_auc"]), 15000.0, False)
            if int(req.get("c_cour", 0)):
                cp.AcceptContract(int(req["c_cour"]), False)
                cp.CompleteContract(int(req["c_cour"]))
            return {"ok": True}
        if cmd == "c2_accept_fleet":
            if int(req.get("fleet_id", 0)):
                self.sm2.RemoteSvc("fleetMgr").AcceptInvite(int(req["fleet_id"]), 0, 0)
            return {"ok": True}
        if cmd == "c2_read_mail":
            try:
                self.sm2.RemoteSvc("mailMgr").GetBody(int(req.get("mail_id", 1)), False)
            except Exception:
                pass
            return {"ok": True}
        return {"ok": False, "error": "unknown cmd %s" % cmd}

    def _handle_cmd(self, req):
        cmd = req.get("cmd", "")
        with self._lock:
            if cmd == "journey_progress":
                if req.get("id") and isinstance(req.get("entry"), dict):
                    self.progress_dict[req["id"]] = req["entry"]
                return {"ok": True}
            if cmd == "driver_finished":
                self.driver_done.set()
                return {"ok": True}
            if cmd == "driver_failed":
                self.driver_error = req.get("error", "unknown")
                self.driver_done.set()
                return {"ok": True}
            for attempt in range(2):
                try:
                    self._ensure_c2(force=(attempt > 0))
                    return self._run_c2_cmd(cmd, req)
                except (OSError, EOFError, RuntimeError):
                    if attempt > 0:
                        raise

    def _serve_loop(self):
        while not self._stop:
            try:
                conn, _ = self._sock.accept()
            except socket.timeout:
                continue
            except Exception:
                break
            try:
                rfile = conn.makefile("r", encoding="utf-8", errors="replace")
                while not self._stop:
                    line = rfile.readline()
                    if not line:
                        break
                    try:
                        req = json.loads(line)
                        resp = self._handle_cmd(req)
                    except Exception as exc:
                        self.log2.info("IPC command error: %r" % (exc,))
                        resp = {"ok": False, "error": repr(exc)}
                    conn.sendall((json.dumps(resp) + "\n").encode("utf-8"))
            except Exception:
                pass
            finally:
                try:
                    conn.close()
                except Exception:
                    pass

    def close(self):
        self._stop = True
        try:
            self._sock.close()
        except Exception:
            pass
        if self.b2 is not None:
            try:
                self.b2.close()
            except Exception:
                pass
        self.log2.close()


def _mint_sso_jwt(host, esi_port, user, password):
    """Mints an SSO access JWT via PKCE `/v2/oauth/authorize` + `/v2/oauth/token`."""
    import base64, hashlib, http.client, urllib.parse
    verifier = "evomu_harness_pkce_verifier_0123456789abcdef"
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode("ascii")).digest()).decode("ascii").rstrip("=")
    redir = "eveauth-evomu://callback"
    hdrs = {"Content-Type": "application/x-www-form-urlencoded"}
    conn = http.client.HTTPConnection(host, int(esi_port), timeout=5.0)
    try:
        conn.request("POST", "/v2/oauth/authorize", urllib.parse.urlencode({
            "response_type": "code", "client_id": "eveLauncherTQ", "redirect_uri": redir,
            "code_challenge": challenge, "code_challenge_method": "S256",
            "scope": "publicData", "username": user, "password": password,
        }), hdrs)
        r1 = conn.getresponse()
        b1 = r1.read().decode("utf-8", "replace")
        code = (json.loads(b1) if b1.strip().startswith("{") else {}).get("code", "")
        if not code:
            code = urllib.parse.parse_qs(urllib.parse.urlparse(r1.getheader("Location") or "").query).get("code", [""])[0]
        conn.request("POST", "/v2/oauth/token", urllib.parse.urlencode({
            "grant_type": "authorization_code", "client_id": "eveLauncherTQ",
            "redirect_uri": redir, "code": code, "code_verifier": verifier,
        }), hdrs)
        return str(json.loads(conn.getresponse().read().decode("utf-8"))["access_token"])
    finally:
        conn.close()


def launch_real_client(client_app, host, macho_port, login, log_path, auto_select_char=90000001, inclient_cfg_path="", quasar_grpc_port=26005, client_logs_dir="", sso_token=""):
    """Starts the real V24.01 `exefile` from a staged copy pointed at EvoMu."""
    stage_dir, exefile_path = stage_real_client(client_app)
    cmd = [exefile_path, "/server:%s" % host, "/port:%d" % macho_port, "/localdevtools", "/tools=evomu", "/silent"]
    if sso_token:
        cmd.append("/ssoToken=%s" % sso_token)
    elif login:
        cmd.append("/login:%s" % login)
    if auto_select_char and not inclient_cfg_path:
        cmd.append("/autoSelectCharacter:%d" % int(auto_select_char))
    if client_logs_dir:
        os.makedirs(client_logs_dir, exist_ok=True)
        cmd.append("/fileLogDirectory:%s" % client_logs_dir)

    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env["EVOMU_HARNESS_DIR"] = HERE
    py_site = os.path.join(stage_dir, "evomu_py_site")
    env["PYTHONPATH"] = py_site
    if inclient_cfg_path:
        env["EVOMU_INCLIENT_CFG"] = inclient_cfg_path
    if quasar_grpc_port:
        env["EVE_PUBLIC_GATEWAY_ADDRESS"] = "%s:%d" % (host, int(quasar_grpc_port))

    preexisting_crashmon = _pids_matching("eve_crashmon")
    logf = open(log_path, "w")
    proc = subprocess.Popen(
        cmd,
        cwd=stage_dir,
        env=env,
        stdout=logf,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    proc.evomu_instance = "/port:%d" % macho_port
    proc.evomu_preexisting_crashmon = preexisting_crashmon
    _SPAWNED.append(proc)
    return proc


def kill_real_client(proc, client_app):
    """Kills only what this harness started: the client's process group, any process whose command
    line carries this run's `/port:<n>` switch, and eve_crashmon helpers that appeared after launch."""
    if proc is None:
        return
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except Exception:
        pass
    try:
        proc.wait(timeout=10)
    except Exception:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except Exception:
            pass
    instance = getattr(proc, "evomu_instance", None)
    before = getattr(proc, "evomu_preexisting_crashmon", set())
    # crashpad re-parents and respawns eve_crashmon when the client dies, so repeat until clean.
    for _ in range(10):
        ours = set()
        if instance:
            ours |= set(p for p in _pids_matching(client_app) if p in _pids_matching(instance))
        ours |= _pids_matching("eve_crashmon") - before
        if not ours:
            break
        for pid in ours:
            try:
                os.kill(pid, signal.SIGKILL)
            except Exception:
                pass
        time.sleep(1)
    if proc in _SPAWNED:
        _SPAWNED.remove(proc)


def _cleanup_spawned(client_app=DEFAULT_CLIENT_APP):
    for proc in list(_SPAWNED):
        if getattr(proc, "evomu_instance", None):
            kill_real_client(proc, client_app)
        else:
            try:
                proc.terminate()
                proc.wait(timeout=5)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
            if proc in _SPAWNED:
                _SPAWNED.remove(proc)


atexit.register(_cleanup_spawned)


def _raise_exit(signum, _frame):
    raise SystemExit(128 + signum)


def run_two_client_bridge_probe(host, bridge_port, client_1_log_path, client_2_log_path):
    """Connects two concurrent `evomu_bridge` clients to `host:bridge_port` and exercises core journeys."""
    evomu_bridge.DEFAULT_RPC_TIMEOUT = 30.0
