def _resolve_client_build_dir(client_app):
    """Resolves either `<EVE.app>/Contents/Resources/build` or a direct `build/` directory."""
    if not client_app:
        return ""
    app_build = os.path.join(client_app, "Contents", "Resources", "build")
    if os.path.exists(os.path.join(app_build, "start.ini")) or os.path.isdir(app_build):
        return app_build
    if os.path.exists(os.path.join(client_app, "start.ini")) or os.path.isdir(
        os.path.join(client_app, "bin64")
    ):
        return client_app
    if os.path.isdir(client_app):
        return client_app
    return app_build


def detect_client_build_info(client_app):
    """Reads `version`, `build`, and `codename` dynamically from the client's `start.ini`."""
    info = {"version": "", "build": "unknown", "codename": "", "start_ini": ""}
    src_build = _resolve_client_build_dir(client_app)
    ini_path = os.path.join(src_build, "start.ini") if src_build else ""
    if not ini_path or not os.path.exists(ini_path):
        return info
    info["start_ini"] = ini_path
    cp = configparser.ConfigParser()
    try:
        cp.read(ini_path, encoding="utf-8")
    except Exception:
        return info
    sec = "main" if cp.has_section("main") else (cp.sections()[0] if cp.sections() else None)
    if sec:
        info["version"] = cp.get(sec, "version", fallback="").strip()
        info["build"] = cp.get(sec, "build", fallback="unknown").strip() or "unknown"
        info["codename"] = cp.get(sec, "codename", fallback="").strip()
    return info


