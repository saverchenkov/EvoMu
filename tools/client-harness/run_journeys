def _pids_matching(pattern):
    out = subprocess.run(["/usr/bin/pgrep", "-f", pattern], capture_output=True, text=True).stdout
    return set(int(p) for p in out.split() if p.isdigit() and int(p) != os.getpid())


def stage_real_client(client_app, stage_root=None):
    """Stages an isolated, writable copy of `EVE.app/Contents/Resources/build` (or `build/`).

    Never modifies the source `EVE.app` bundle. Detects build ID dynamically from
    `start.ini` and stages into `<stage_root>/client_build_<build>`. Configures
    `common.ini` with `cryptoPack = Placebo` and installs `tools/startup/evomu.py`
    so `/tools=evomu` launches `evomu_inclient_driver.schedule_startup()`.
    """
    src_build = _resolve_client_build_dir(client_app)
    build_info = detect_client_build_info(client_app)
    build_id = build_info.get("build") or "unknown"
    root_dir = stage_root or _default_stage_root()
    stage_dir = os.path.join(root_dir, "client_build_%s" % build_id)
    exefile_path = os.path.join(stage_dir, "bin64", "exefile")
    src_exefile = os.path.join(src_build, "bin64", "exefile")
    src_ini = os.path.join(src_build, "start.ini")
    dst_ini = os.path.join(stage_dir, "start.ini")
    needs_copy = (
        not os.path.exists(stage_dir)
        or (os.path.exists(src_exefile) and not os.path.exists(exefile_path))
        or (os.path.exists(src_ini) and not os.path.exists(dst_ini))
    )
    if not needs_copy and os.path.exists(src_ini) and os.path.exists(dst_ini):
        try:
            needs_copy = os.path.getmtime(src_ini) > os.path.getmtime(dst_ini)
        except OSError:
            needs_copy = True
    if needs_copy:
        os.makedirs(os.path.dirname(stage_dir), exist_ok=True)
        tmp_stage = stage_dir + ".staging"
        if os.path.exists(tmp_stage):
            shutil.rmtree(tmp_stage)
        if os.path.exists(stage_dir):
            shutil.rmtree(stage_dir)
        cp_res = subprocess.run(["/bin/cp", "-cR", src_build, tmp_stage], capture_output=True)
        if cp_res.returncode != 0:
            if os.path.exists(tmp_stage):
                shutil.rmtree(tmp_stage)
            shutil.copytree(src_build, tmp_stage, symlinks=True)
        os.replace(tmp_stage, stage_dir)

    with open(os.path.join(stage_dir, "common.ini"), "w") as cf:
        cf.write("[main]\ncryptoPack = Placebo\n")

    startup_dir = os.path.join(stage_dir, "tools", "startup")
    os.makedirs(startup_dir, exist_ok=True)
    for init_p in (
        os.path.join(stage_dir, "tools", "__init__.py"),
        os.path.join(startup_dir, "__init__.py"),
    ):
        if not os.path.exists(init_p):
            with open(init_p, "w") as pf:
                pf.write("")

    evomu_boot = (
        "import os\n"
        "import sys\n"
        "sys.dont_write_bytecode = True\n"
        "_hdir = os.environ.get('EVOMU_HARNESS_DIR', '')\n"
        "if _hdir and _hdir not in sys.path:\n"
        "    sys.path.insert(0, _hdir)\n"
        "try:\n"
        "    import evomu_site\n"
        "    evomu_site.install()\n"
        "    evomu_site._install_logmodule_hook()\n"
        "except Exception:\n"
        "    pass\n"
        "import evomu_inclient_driver\n"
        "evomu_inclient_driver.schedule_startup()\n"
    )
    with open(os.path.join(startup_dir, "evomu.py"), "w") as ef:
        ef.write(evomu_boot)
    # In packaged client builds, inittools also searches root:/../tools/startup
    parent_startup_dir = os.path.join(os.path.dirname(stage_dir), "tools", "startup")
    try:
        os.makedirs(parent_startup_dir, exist_ok=True)
        with open(os.path.join(parent_startup_dir, "evomu.py"), "w") as pef:
            pef.write(evomu_boot)
    except Exception:
        pass
    _install_stage_sitecustomize(stage_dir)
    return stage_dir, exefile_path


def _install_stage_sitecustomize(stage_dir):
    """Installs `sitecustomize.py` into `stage_dir` search paths without modifying signed `code.ccp`."""
    py_site = os.path.join(stage_dir, "evomu_py_site")
    os.makedirs(py_site, exist_ok=True)
    hook_src = (
        "import os, sys\n"
        "sys.dont_write_bytecode = True\n"
        "_h = os.environ.get('EVOMU_HARNESS_DIR', '')\n"
        "if _h and _h not in sys.path:\n"
        "    sys.path.insert(0, _h)\n"
        "try:\n"
        "    import evomu_site\n"
        "    evomu_site.install()\n"
        "except Exception:\n"
        "    pass\n"
    )
    for dest_dir in (
        py_site,
        os.path.join(stage_dir, "bin64"),
        os.path.join(stage_dir, "bin64", "packages"),
        stage_dir,
    ):
        try:
            os.makedirs(dest_dir, exist_ok=True)
            with open(os.path.join(dest_dir, "sitecustomize.py"), "w") as sf:
                sf.write(hook_src)
            with open(os.path.join(dest_dir, "usercustomize.py"), "w") as uf:
                uf.write(hook_src)
        except OSError:
            pass
    return py_site


def _host_capture_window(path, client_pid):
    if not (path and client_pid):
        return False
    try:
        import Quartz
        wins = Quartz.CGWindowListCopyWindowInfo(
            Quartz.kCGWindowListOptionAll, Quartz.kCGNullWindowID
        )
        best_wid = None
        best_area = 0
        for w in (wins or []):
            if int(w.get("kCGWindowOwnerPID", 0) or 0) != int(client_pid):
                continue
            bounds = w.get("kCGWindowBounds", {}) or {}
            area = int(bounds.get("Width", 0) or 0) * int(bounds.get("Height", 0) or 0)
            if area > best_area and int(w.get("kCGWindowLayer", 0) or 0) == 0:
                best_area = area
                best_wid = int(w.get("kCGWindowNumber", 0) or 0)
        if best_wid:
            os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
            res = subprocess.run(
                ["/usr/sbin/screencapture", "-x", "-l", str(best_wid), path],
                capture_output=True,
                timeout=10,
            )
            return res.returncode == 0 and os.path.exists(path) and os.path.getsize(path) > 0
    except Exception:
        pass
    return False


