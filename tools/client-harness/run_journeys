            raise RuntimeError("Failed to resolve client 1 shipID from SelectCharacterID or session state")
        client1_ship_id = int(client1_ship_id)
        log1.info("Resolved Client 1 shipID: %d" % client1_ship_id)

        # Exercise V24.01 post-login / character-selection startup RPCs fired by real EVE.app
