        outcomes["cosmetics_store"] = {
            "bridge_verified": (int(fc2_buy["newPlexBalance"]) >= 50100 and fc_enabled is True and float(first_pack["price"]) == 0.0 and fc_buy3.get("status") == "COMPLETED" and can_buy is True and getattr(nes_buy, "success", False) is True and rem_plex == new_plex_bal - nes_price and delivered_item_id > 0 and cosmetics is not None and isinstance(skins, list) and len(skins) >= 1),
            "evidence": "Client 2 starter PLEX + pack (%d PLEX); Client 1 $0.00 FastCheckout PLEX (%d PLEX), NES storeManager.buy_offer(offer=%d, price=%d -> plexRemaining=%d, item=%d), and shipCosmeticsMgr SKIN activation (%d licensed skins, vgs_cats=%d)" % (int(fc2_buy["newPlexBalance"]), new_plex_bal, nes_offer_id, nes_price, rem_plex, delivered_item_id, len(skins), len(vgs_cats)),
